# Ghostty config

# ---------------------------------------------------------------------------
# Theme
# NOTE: 下の固定 background/foreground/palette と window-theme = dark が
# theme の light/dark 自動切替を実質上書きしている (light 側はほぼ発現しない)。
# 固定色をやめて自動切替に戻す場合は、下の Vivid colors セクションごと削除すること。
# ---------------------------------------------------------------------------
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# ---------------------------------------------------------------------------
# Vivid colors
# ---------------------------------------------------------------------------
background = #1E1233
foreground = #F0F6FF

# Faint circuit traces behind the text. The file is mostly transparent (under
# 4% of pixels carry ink, at about a tenth opacity), so it lifts the flat
# background rather than competing with anything on top of it. Regenerate or
# retune with terminal/ghostty/make-background.py; drop these three lines to
# go back to a plain background.
background-image = ~/.config/ghostty/background.png
background-image-fit = cover
background-image-repeat = false
# One knob for the whole image. The file peaks at 69/255 alpha, so 1.0 is
# already restrained; lower this to fade it further rather than regenerating.
background-image-opacity = 1.0
cursor-color = #8FDBFF
# Steady, not blinking: on a highlighted row in a TUI (lazygit's selected
# line) a blinking block reads as the text itself flickering.
cursor-style-blink = false
cursor-text = #0B1020
selection-foreground = #0B1020
minimum-contrast = 1.2

# ANSI palette (vivid overrides for dark purple background)
palette = 1=#FF5C8A
palette = 2=#5CFFB4
palette = 3=#FFD45C
palette = 4=#5CC8FF
palette = 5=#C18CFF
palette = 6=#5CFFF2
palette = 9=#FF8FAF
palette = 10=#8FFFD4
palette = 11=#FFE08F
palette = 12=#8FDBFF
palette = 13=#D6B3FF
palette = 14=#8FFFF8

# ---------------------------------------------------------------------------
# Font
# ---------------------------------------------------------------------------
font-family = Monaspace Neon
font-feature = calt
font-feature = liga
font-feature = dlig
font-size = 15
font-thicken = true
font-thicken-strength = 140
adjust-cell-height = 10%

# HackGen
font-family = HackGen
font-codepoint-map = U+3000-U+303F,U+3040-U+309F,U+30A0-U+30FF,U+4E00-U+9FFF,U+FF00-U+FFEF=HackGen
font-codepoint-map = U+3400-U+4DBF,U+20000-U+2A6DF=HackGen

# Nerd Font icons. Neither Monaspace Neon nor HackGen carries the private-use
# codepoints the file-type icons live in (checked with fc-list: they have none
# of U+E5FF, U+F07B, U+F15B), so without this every icon renders as a box.
#
# The ranges are derived from the icons nvim-web-devicons actually ships rather
# than written by hand -- a hand-written set left 86 of its 338 glyphs outside
# the mapping, which would have shown as boxes for exactly the file types that
# happened to fall in the gaps.
#   regenerate: see the derivation in git history for this file
font-family = FiraCode Nerd Font
font-codepoint-map = U+E000-E00A,U+E0A0-E0D4,U+E200-E2A9,U+E21C,U+E271=FiraCode Nerd Font
font-codepoint-map = U+E28B-E28C,U+E2A6,U+E300-E3E3,U+E5FA-E6B7,U+E600-E6B8=FiraCode Nerd Font
font-codepoint-map = U+E700-E8EF,U+E702-E7BA,U+E80F-E81E,U+E838-E865,U+E8B3=FiraCode Nerd Font
font-codepoint-map = U+E8D1-E8D9,U+E8EB,U+EA60-EC1E,U+EAC4,U+EAE8-EAEB=FiraCode Nerd Font
font-codepoint-map = U+EB9C,U+EBC6-EBC8,U+EBE8-EBF6,U+ED00-EFCE,U+EDCA=FiraCode Nerd Font
font-codepoint-map = U+EDFE,U+EE72,U+EEB6,U+EEF6,U+F000-F2FF=FiraCode Nerd Font
font-codepoint-map = U+F001-F005,U+F019,U+F031,U+F054,U+F06D-F076=FiraCode Nerd Font
font-codepoint-map = U+F0AD,U+F0C6,U+F0EC-F108,U+F129,U+F15B=FiraCode Nerd Font
font-codepoint-map = U+F179-F17C,U+F1AB-F1B2,U+F1D8,U+F20E,U+F23E=FiraCode Nerd Font
font-codepoint-map = U+F296,U+F2B8,U+F2D0,U+F2EC-F381,U+F300-F375=FiraCode Nerd Font
font-codepoint-map = U+F400-F533,U+F410,U+F423,U+F462,U+F487-F49B=FiraCode Nerd Font
font-codepoint-map = U+F4AE,U+F0001-F1AF0,U+F006F,U+F00A8-F00BA,U+F019A-F01A7=FiraCode Nerd Font
font-codepoint-map = U+F0219-F022C,U+F02A2,U+F031B-F0331,U+F035B,U+F042B-F0431=FiraCode Nerd Font
font-codepoint-map = U+F0483,U+F04C6,U+F04D9,U+F0565,U+F057C=FiraCode Nerd Font
font-codepoint-map = U+F05C0-F05CA,U+F0627,U+F0673,U+F06A9,U+F06D3-F06E2=FiraCode Nerd Font
font-codepoint-map = U+F0718-F072B,U+F07D4-F07E2,U+F0858-F0868,U+F08C7,U+F08E8=FiraCode Nerd Font
font-codepoint-map = U+F099D,U+F0A0A-F0A16,U+F0AAE,U+F0BC4,U+F0CB9=FiraCode Nerd Font
font-codepoint-map = U+F0DD6,U+F0EBE,U+F0EEB,U+F1049,U+F1106=FiraCode Nerd Font
font-codepoint-map = U+F111B,U+F121A,U+F125F,U+F13FF,U+F1997-F1998=FiraCode Nerd Font

# ---------------------------------------------------------------------------
# Window
# ---------------------------------------------------------------------------
# background-opacity = 0.80
# background-opacity-cells = true
# background-blur = 24
window-padding-y = 2,8
window-padding-x = 8,8
window-padding-balance = true
window-padding-color = extend
fullscreen = false
macos-titlebar-style = tabs
window-theme = dark
window-title-font-family = Monaspace Neon
# When you toggle fullscreen manually: non-native + menu visible (tabs + non-native have caveats in Ghostty docs).
macos-non-native-fullscreen = visible-menu

# ---------------------------------------------------------------------------
# Terminal
# ---------------------------------------------------------------------------
scrollback-limit = 10000
shell-integration = zsh
mouse-shift-capture = true

# ---------------------------------------------------------------------------
# Bell
# ---------------------------------------------------------------------------
bell-features = system,audio,attention,title

# ---------------------------------------------------------------------------
# Link / Notifications
# ---------------------------------------------------------------------------
link-url = true
notify-on-command-finish = unfocused

# ---------------------------------------------------------------------------
# Keybindings
# ---------------------------------------------------------------------------
config-file = keybindings.conf
