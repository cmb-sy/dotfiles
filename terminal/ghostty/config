# Ghostty config

# ---------------------------------------------------------------------------
# Theme
# Colours come from the theme. Nothing below overrides background, foreground
# or the ANSI palette, so the light/dark pair actually switches with the system.
# ---------------------------------------------------------------------------
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# ---------------------------------------------------------------------------
# Legibility
# These are not colours -- they survive a theme change.
# ---------------------------------------------------------------------------
# Steady, not blinking: on a highlighted row in a TUI (lazygit's selected
# line) a blinking block reads as the text itself flickering.
cursor-style-blink = false
# Floor on text-against-cell contrast, whatever the theme picks.
minimum-contrast = 1.2

# ---------------------------------------------------------------------------
# Font
# ---------------------------------------------------------------------------
font-family = Monaspace Neon
font-feature = calt
font-feature = liga
font-feature = dlig
font-size = 15
font-thicken = true
font-thicken-strength = 140
adjust-cell-height = 10%

# HackGen
font-family = HackGen
font-codepoint-map = U+3000-U+303F,U+3040-U+309F,U+30A0-U+30FF,U+4E00-U+9FFF,U+FF00-U+FFEF=HackGen
font-codepoint-map = U+3400-U+4DBF,U+20000-U+2A6DF=HackGen

# Nerd Font icons. Neither Monaspace Neon nor HackGen carries the private-use
# codepoints the file-type icons live in (checked with fc-list: they have none
# of U+E5FF, U+F07B, U+F15B), so without this every icon renders as a box.
#
# The ranges are derived from the icons nvim-web-devicons actually ships rather
# than written by hand -- a hand-written set left 86 of its 338 glyphs outside
# the mapping, which would have shown as boxes for exactly the file types that
# happened to fall in the gaps.
#   regenerate: see the derivation in git history for this file
# Both ends of a range need the U+ prefix. Ghostty rejects U+E000-E00A and
# drops the whole line, so the mapping silently does nothing; run
# `ghostty +validate-config` after editing these.
font-family = FiraCode Nerd Font
font-codepoint-map = U+E000-U+E00A,U+E0A0-U+E0D4,U+E200-U+E2A9,U+E21C,U+E271=FiraCode Nerd Font
font-codepoint-map = U+E28B-U+E28C,U+E2A6,U+E300-U+E3E3,U+E5FA-U+E6B7,U+E600-U+E6B8=FiraCode Nerd Font
font-codepoint-map = U+E700-U+E8EF,U+E702-U+E7BA,U+E80F-U+E81E,U+E838-U+E865,U+E8B3=FiraCode Nerd Font
font-codepoint-map = U+E8D1-U+E8D9,U+E8EB,U+EA60-U+EC1E,U+EAC4,U+EAE8-U+EAEB=FiraCode Nerd Font
font-codepoint-map = U+EB9C,U+EBC6-U+EBC8,U+EBE8-U+EBF6,U+ED00-U+EFCE,U+EDCA=FiraCode Nerd Font
font-codepoint-map = U+EDFE,U+EE72,U+EEB6,U+EEF6,U+F000-U+F2FF=FiraCode Nerd Font
font-codepoint-map = U+F001-U+F005,U+F019,U+F031,U+F054,U+F06D-U+F076=FiraCode Nerd Font
font-codepoint-map = U+F0AD,U+F0C6,U+F0EC-U+F108,U+F129,U+F15B=FiraCode Nerd Font
font-codepoint-map = U+F179-U+F17C,U+F1AB-U+F1B2,U+F1D8,U+F20E,U+F23E=FiraCode Nerd Font
font-codepoint-map = U+F296,U+F2B8,U+F2D0,U+F2EC-U+F381,U+F300-U+F375=FiraCode Nerd Font
font-codepoint-map = U+F400-U+F533,U+F410,U+F423,U+F462,U+F487-U+F49B=FiraCode Nerd Font
font-codepoint-map = U+F4AE,U+F0001-U+F1AF0,U+F006F,U+F00A8-U+F00BA,U+F019A-U+F01A7=FiraCode Nerd Font
font-codepoint-map = U+F0219-U+F022C,U+F02A2,U+F031B-U+F0331,U+F035B,U+F042B-U+F0431=FiraCode Nerd Font
font-codepoint-map = U+F0483,U+F04C6,U+F04D9,U+F0565,U+F057C=FiraCode Nerd Font
font-codepoint-map = U+F05C0-U+F05CA,U+F0627,U+F0673,U+F06A9,U+F06D3-U+F06E2=FiraCode Nerd Font
font-codepoint-map = U+F0718-U+F072B,U+F07D4-U+F07E2,U+F0858-U+F0868,U+F08C7,U+F08E8=FiraCode Nerd Font
font-codepoint-map = U+F099D,U+F0A0A-U+F0A16,U+F0AAE,U+F0BC4,U+F0CB9=FiraCode Nerd Font
font-codepoint-map = U+F0DD6,U+F0EBE,U+F0EEB,U+F1049,U+F1106=FiraCode Nerd Font
font-codepoint-map = U+F111B,U+F121A,U+F125F,U+F13FF,U+F1997-U+F1998=FiraCode Nerd Font

# ---------------------------------------------------------------------------
# Window
# ---------------------------------------------------------------------------
# background-opacity = 0.80
# background-opacity-cells = true
# background-blur = 24
window-padding-y = 2,8
window-padding-x = 8,8
window-padding-balance = true
window-padding-color = extend
fullscreen = false
macos-titlebar-style = tabs
window-theme = auto
window-title-font-family = Monaspace Neon
# When you toggle fullscreen manually: non-native + menu visible (tabs + non-native have caveats in Ghostty docs).
macos-non-native-fullscreen = visible-menu

# ---------------------------------------------------------------------------
# Terminal
# ---------------------------------------------------------------------------
scrollback-limit = 10000
shell-integration = zsh
mouse-shift-capture = true

# ---------------------------------------------------------------------------
# Bell
# ---------------------------------------------------------------------------
bell-features = system,audio,attention,title

# ---------------------------------------------------------------------------
# Link / Notifications
# ---------------------------------------------------------------------------
link-url = true
notify-on-command-finish = unfocused

# ---------------------------------------------------------------------------
# Keybindings
# ---------------------------------------------------------------------------
config-file = keybindings.conf
