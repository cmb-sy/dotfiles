<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Some apps (e.g. Ghostty, known bug:
  https://github.com/ghostty-org/ghostty/discussions/10480) enable macOS
  Secure Input Mode for a password prompt and fail to disable it afterward.
  While enabled, the holding app exclusively receives all keyboard input,
  silently blocking other apps' global hotkeys (e.g. Typeless/Handy voice
  input via Karabiner Caps Lock). This agent polls every 60s. When Ghostty
  holds Secure Input because its "Secure Keyboard Entry" menu toggle is
  persisted ON, it clicks that menu item to release it -- which needs
  Accessibility permission for osascript, or the click silently fails.
  Otherwise it only notifies (never kills the app) once the same process has
  held Secure Input for 2+ minutes. See bin/secure-input-watch.

  The program path below is a placeholder; setup/install.zsh substitutes the
  repo path into it at install time, so the repo can live anywhere.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.snakashima.secure-input-watch</string>
    <key>ProgramArguments</key>
    <array>
        <string>__DOTFILES__/bin/secure-input-watch</string>
    </array>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/secure-input-watch.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/secure-input-watch.log</string>
</dict>
</plist>
