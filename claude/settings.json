  "hooks": {
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "\"${HOME}/.claude/hooks/notify.sh\" 'Task completed'"
          },
          {
            "type": "command",
            "command": "\"${HOME}/.claude/hooks/discord-relay.sh\" 'Task completed'"
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "\"${HOME}/.claude/hooks/notify.sh\" 'Waiting for approval'"
          },
          {
            "type": "command",
            "command": "\"${HOME}/.claude/hooks/discord-relay.sh\" 'Waiting for approval'"
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "\"${HOME}/.claude/hooks/notify.sh\" 'Waiting for your answer'"
          },
          {
            "type": "command",
            "command": "\"${HOME}/.claude/hooks/discord-relay.sh\" 'Waiting for your answer'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if jq -r '.tool_input.command // empty' 2>/dev/null | grep -qE 'git commit'; then \"${HOME}/.claude/hooks/post-commit.sh\"; fi",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${HOME}/.claude/hooks/pii-guard.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${HOME}/.claude/hooks/deploy-guard.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if jq -r '.tool_input.command // empty' 2>/dev/null | grep -qE '(rm[[:space:]]+-rf[[:space:]]+((/|~|\\$HOME)[[:space:]]*$|(/usr|/etc|/var|/opt|/System)(/|[[:space:]]|$))|>[[:space:]]*/dev/sd|mkfs|dd[[:space:]]+if=)'; then echo 'BLOCK: Destructive system command detected' >&2; exit 2; fi"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${HOME}/.claude/hooks/session-start.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${HOME}/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${HOME}/.claude/hooks/stop.sh\"",
            "timeout": 30,
            "async": true
          },
          {
            "type": "command",
            "command": "\"${HOME}/.claude/hooks/discord-relay.sh\""
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${HOME}/.claude/hooks/stop-failure-handler.sh\"",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"${HOME}/.claude/statusline.sh\"",
    "padding": 0
  },
