{
    "global": {
        "show_in_menu_bar": false
    },
    "profiles": [
        {
            "name": "Default profile",
            "selected": true,
            "virtual_hid_keyboard": {
                "keyboard_type_v2": "jis"
            },
            "complex_modifications": {
                "rules": [
                    {
                        "description": "F1 → voice-out (今フォーカスされているターミナル画面のテキストを再生/停止トグル)",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "f1",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    { "shell_command": "$HOME/dotfiles/bin/voice-out" }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "Caps Lock -> Handy の録音トグル (bin/voice-toggle)。",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    { "shell_command": "$HOME/dotfiles/bin/voice-toggle" }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "herdr: Fn+Cmd+矢印でタブ/スペース移動。Ghostty は fn をモディファイアとして扱えないため、Karabiner で既存の Cmd+Shift+[ ・ Cmd+Shift+] ・ Cmd+Opt+Up/Down（herdr の previous_tab/next_tab/previous_workspace/next_workspace）にリマップする",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "left_arrow",
                                    "modifiers": { "mandatory": ["fn", "command"] }
                                },
                                "to": [
                                    { "key_code": "open_bracket", "modifiers": ["command", "shift"] }
                                ],
                                "conditions": [
                                    { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.mitchellh\\.ghostty$"] }
                                ]
                            },
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "right_arrow",
                                    "modifiers": { "mandatory": ["fn", "command"] }
                                },
                                "to": [
                                    { "key_code": "close_bracket", "modifiers": ["command", "shift"] }
                                ],
                                "conditions": [
                                    { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.mitchellh\\.ghostty$"] }
                                ]
                            },
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "up_arrow",
                                    "modifiers": { "mandatory": ["fn", "command"] }
                                },
                                "to": [
                                    { "key_code": "up_arrow", "modifiers": ["command", "option"] }
                                ],
                                "conditions": [
                                    { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.mitchellh\\.ghostty$"] }
                                ]
                            },
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "down_arrow",
                                    "modifiers": { "mandatory": ["fn", "command"] }
                                },
                                "to": [
                                    { "key_code": "down_arrow", "modifiers": ["command", "option"] }
                                ],
                                "conditions": [
                                    { "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.mitchellh\\.ghostty$"] }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "Fn combos: fn+space switches input source, fn+c sends Escape, fn+f formats clipboard via Claude (ai-format)",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "spacebar",
                                    "modifiers": { "mandatory": ["fn"] }
                                },
                                "to": [
                                    { "key_code": "spacebar", "modifiers": ["left_control"] }
                                ]
                            },
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "c",
                                    "modifiers": { "mandatory": ["fn"] }
                                },
                                "to": [
                                    { "key_code": "escape" }
                                ]
                            },
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "f",
                                    "modifiers": { "mandatory": ["fn"] }
                                },
                                "to": [
                                    { "shell_command": "$HOME/dotfiles/bin/ai-format" }
                                ]
                            }
                        ]
                    }
                ]
            }
        }
    ]
}
