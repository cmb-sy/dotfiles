#!/usr/bin/env -S python3 -I
"""Claude Code's statusline in a pane on the right of the agent pane.

  herdr-statusline toggle        open the pane beside this tab's agent pane, or
                                 close it when the tab has one (Cmd+Ctrl+P)
  herdr-statusline panel <pane>  show that pane's statusline; q closes it

claude/statusline.sh writes the lines to $HERDR_STATUSLINE_DIR/<pane id>
(default ~/.cache/claude-statusline) instead of under the prompt. The pane
carries the label "statusline", which is how toggle finds it.
Overrides: HERDR_BIN, HERDR_PANE_ID (the pane toggle runs in),
HERDR_STATUSLINE_SELF (the command a new pane runs; default this file).
"""
import json, os, re, select, subprocess, sys, termios, time, tty, unicodedata

HERDR = os.environ.get("HERDR_BIN") or "herdr"
DIR = os.environ.get("HERDR_STATUSLINE_DIR") or os.path.join(
    os.path.expanduser("~"), ".cache", "claude-statusline")
LABEL = "statusline"
# The pane takes the right fifth of the pane it splits.
RATIO = "0.8"
REFRESH = 1.0
ESC = re.compile(r"\x1b\[[0-9;]*m")
# Control characters (ESC included): file contents must not drive the terminal.
CONTROL = re.compile(r"[\x00-\x1f\x7f-\x9f]")


def clean(s):
    return CONTROL.sub("", ESC.sub("", s))


class HerdrError(Exception):
    pass


def herdr(*args):
    try:
        p = subprocess.run([HERDR, *args], stdin=subprocess.DEVNULL, capture_output=True,
                           text=True, timeout=10)
    except (OSError, subprocess.SubprocessError) as e:
        raise HerdrError(str(e))
    if p.returncode != 0:
        raise HerdrError((p.stderr or p.stdout).strip() or "herdr %s failed" % args[0])
    if not p.stdout.strip():
        # Some commands (pane run) answer with nothing on success.
        return {}
    try:
        return json.loads(p.stdout).get("result") or {}
    except ValueError:
        raise HerdrError("herdr %s: not JSON" % " ".join(args[:2]))


def text(v):
    return v if isinstance(v, str) else ""


def toggle():
    me = os.environ.get("HERDR_PANE_ID") or ""
    if not me:
        print("herdr-statusline: run inside herdr", file=sys.stderr)
        return 1
    try:
        here = herdr("pane", "get", me).get("pane") or {}
        tab, ws = text(here.get("tab_id")), text(here.get("workspace_id"))
        panes = [p for p in herdr("pane", "list", "--workspace", ws).get("panes") or []
                 if text(p.get("tab_id")) == tab and text(p.get("pane_id")) != me]
        mine = [p for p in panes if text(p.get("label")) == LABEL]
        if mine:
            for p in mine:
                herdr("pane", "close", text(p["pane_id"]))
            return 0
        # The agent's pane, else the first one; the key's own pane is never split.
        target = next((p for p in panes if p.get("agent")), panes[0] if panes else None)
        if target is None:
            return 0
        pid = text(target.get("pane_id"))
        new = text((herdr("pane", "split", pid, "--direction", "right", "--ratio", RATIO,
                          "--no-focus").get("pane") or {}).get("pane_id"))
        if not new:
            raise HerdrError("split gave no pane")
        herdr("pane", "rename", new, LABEL)
        self = (os.environ.get("HERDR_STATUSLINE_SELF") or os.path.abspath(__file__)).replace("'", "")
        # exec, so the pane closes when the panel quits.
        herdr("pane", "run", new, "exec '%s' panel '%s'" % (self, pid.replace("'", "")))
    except HerdrError as e:
        print("herdr-statusline: %s" % e, file=sys.stderr)
        return 1
    return 0


def width(s):
    return sum(0 if unicodedata.category(c) in ("Mn", "Me", "Cf") or 0xFE00 <= ord(c) <= 0xFE0F
               else 2 if unicodedata.east_asian_width(c) in ("W", "F") else 1 for c in s)


def wrap(line, room, indent="   "):
    # Split a coloured line into rows of at most `room` columns, breaking at a
    # space when one is near; later rows start with `indent`. Escapes are kept
    # and each row ends its colour.
    rows, cur, used, style = [], "", 0, ""
    words = re.split(r"(\x1b\[[0-9;]*m| )", line)
    for w in words:
        if not w:
            continue
        if ESC.fullmatch(w):
            cur += w
            style = "" if w == "\x1b[0m" else w
            continue
        ww = width(w)
        if used + ww > room and used > width(indent):
            rows.append(cur + "\x1b[0m")
            cur, used = indent + style, width(indent)
            if w == " ":
                continue
        while used + ww > room:
            # A word longer than a row is split by characters.
            take = ""
            for c in w:
                if used + width(take + c) > room:
                    break
                take += c
            if not take:
                break
            rows.append(cur + take + "\x1b[0m")
            w = w[len(take):]
            ww = width(w)
            cur, used = indent + style, width(indent)
        cur += w
        used += ww
    rows.append(cur)
    return rows


HEADING = "1;34"
DIM = "90"
STATE_MARK = {"working": "●", "blocked": "!", "idle": "○"}
# herdr's own state colours: idle green, working yellow, blocked red.
STATE_STYLE = {"idle": "32", "working": "33", "blocked": "31"}
# Groups whose values start with a percentage get a small bar before them.
BARRED = ("Context left", "Usage left")
BAR = 8
PERCENT = re.compile(r"(\d{1,3})%")


def state(pid):
    # The agent's state from herdr as a "State" line, or None.
    try:
        got = text((herdr("pane", "get", pid).get("pane") or {}).get("agent_status"))
    except HerdrError:
        return None
    if not got or got == "unknown":
        return None
    return "State\t%s %s" % (STATE_MARK.get(got, "·"), got)


# A subagent counts as working while its transcript changed this recently.
BUSY_SECONDS = 30
# Subagents quiet for longer than this are left out.
AGENT_WINDOW = 3600
MAX_AGENTS = 8


def agents(transcript):
    # "Agents" lines for the session's subagents, working first, then newest.
    folder = os.path.join(transcript[:-len(".jsonl")] if transcript.endswith(".jsonl")
                          else transcript, "subagents")
    try:
        names = os.listdir(folder)
    except OSError:
        return []
    t, found = time.time(), []
    for name in names:
        if not name.endswith(".jsonl"):
            continue
        path = os.path.join(folder, name)
        try:
            age = t - os.stat(path).st_mtime
        except OSError:
            continue
        if age > AGENT_WINDOW:
            continue
        try:
            with open(path[:-len(".jsonl")] + ".meta.json", encoding="utf-8") as f:
                meta = json.load(f)
        except (OSError, ValueError):
            meta = {}
        label = clean(text(meta.get("name")) or text(meta.get("agentType")) or name[6:-6])[:24]
        desc = clean(text(meta.get("description")))[:80]
        found.append((age > BUSY_SECONDS, age, label, desc))
    found.sort()
    out = []
    for idle, _, label, desc in found[:MAX_AGENTS]:
        out.append("Agents\t%s %s" % ("○" if idle else "●", label))
        if desc:
            out.append("Agents\t  " + desc)
    if len(found) > MAX_AGENTS:
        out.append("Agents\t+%d more" % (len(found) - MAX_AGENTS))
    return out


def bar(percent):
    filled = round(max(0, min(percent, 100)) * BAR / 100)
    return "▰" * filled + "\x1b[%sm%s\x1b[0m" % (DIM, "▱" * (BAR - filled))


def lines(pid):
    # "<heading>\t<value>" lines become a heading over its indented values,
    # with a blank line between groups; a line without a tab shows as it is.
    path = os.path.join(DIR, re.sub(r"[^A-Za-z0-9:_-]", "_", pid))
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            got = [l for l in f.read().splitlines() if l.strip()]
    except OSError:
        got = []
    # "#" lines carry data for the pane, not lines to show.
    meta = dict(l[1:].partition("\t")[::2] for l in got if l.startswith("#"))
    got = [l for l in got if not l.startswith("#")]
    if meta.get("transcript"):
        got += agents(meta["transcript"])
    now = state(pid)
    if now:
        got.insert(0, now)
    if not got:
        return ["\x1b[%smWaiting for Claude\x1b[0m" % DIM]
    out, last = [], None
    for line in got:
        head, tab, value = line.partition("\t")
        if not tab:
            out.append(clean(line))
            continue
        head = clean(head)
        if head != last:
            if out:
                out.append("")
            out.append("\x1b[%sm%s\x1b[0m" % (HEADING, head))
            last = head
        m = PERCENT.search(value) if head in BARRED else None
        value = clean(value)
        if head == "State":
            word = value.split()[-1] if value.split() else ""
            value = "\x1b[%sm%s\x1b[0m" % (STATE_STYLE.get(word, "1"), value)
        out.append(" " + (bar(int(m.group(1))) + " " if m else "") + value)
    return out


def panel(pid):
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        print("herdr-statusline: panel needs a terminal", file=sys.stderr)
        return 2
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        sys.stdout.write("\x1b[?1049h\x1b[?25l")
        last = None
        while True:
            size = os.get_terminal_size()
            # One spare column on each side.
            room = max(size.columns - 2, 4)
            frame = [" " + row for l in lines(pid) for row in wrap(l, room)][:size.lines]
            if (frame, size) != last:
                sys.stdout.write("\x1b[H" + "\x1b[K\r\n".join(frame) + "\x1b[K\x1b[J")
                sys.stdout.flush()
                last = (frame, size)
            if select.select([fd], [], [], REFRESH)[0]:
                data = os.read(fd, 64)
                if not data or b"q" in data or b"\x03" in data:
                    return 0
    except KeyboardInterrupt:
        return 0
    finally:
        termios.tcsetattr(fd, termios.TCSANOW, saved)
        sys.stdout.write("\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()


def main(argv):
    if argv == ["toggle"]:
        return toggle()
    if len(argv) == 2 and argv[0] == "panel" and argv[1]:
        return panel(argv[1])
    print("usage: herdr-statusline toggle | panel <pane_id>", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
