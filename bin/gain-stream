#!/usr/bin/env python3
"""Fetch dated items for the gain watch's daily flow layer.

  gain-stream topics   --since <ISO8601> <sources.yaml>   topics + people
  gain-stream discover --since <ISO8601> <sources.yaml>   trending, any field
  gain-stream budget   <sources.yaml>                     requests one run spends

stdout: one JSON item per line. stderr: one JSON status per fetch.
Exit 0 when every fetch worked, 2 when some failed, 1 when all failed or the
config is unreadable, 64 on bad usage.

A source that filters by date on the server must not return anything older
than --since (minus a day of slack): some APIs silently drop a bad filter and
return everything, so an old item fails that fetch with "window not applied".
Sources that cannot filter are cut here.

GAIN_STREAM_FIXTURES=<dir> answers every request from <dir>/<source>-<slug>
so tests never reach the network. GAIN_STREAM_NOW pins the clock.
"""
import datetime as dt
import email.utils
import hashlib
import html
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET

try:
    import yaml
except ImportError:
    # Homebrew's python3 is externally managed and has no PyYAML; setup puts
    # it in mise's interpreter (same resolution as bin/gain-state).
    alt = ""
    try:
        alt = subprocess.run(["mise", "which", "python3"], capture_output=True,
                             text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    if alt and not os.environ.get("GAIN_STREAM_REEXEC") \
            and os.path.realpath(alt) != os.path.realpath(sys.executable):
        os.environ["GAIN_STREAM_REEXEC"] = "1"
        os.execv(alt, [alt, os.path.abspath(__file__), *sys.argv[1:]])
    print("gain-stream: PyYAML is not installed", file=sys.stderr)
    sys.exit(1)

EXIT_OK, EXIT_ALL_FAILED, EXIT_SOME_FAILED, EXIT_USAGE = 0, 1, 2, 64
TIMEOUT = 20
# Feeds are parsed with the stdlib ElementTree: it does not fetch external
# entities, and the bundled expat (>= 2.4.1) caps entity expansion. The size
# cap bounds what a hostile or broken server can make us hold.
MAX_BYTES = 5 * 1024 * 1024
UA = "gain-stream/1 (personal tech digest)"
SLACK = dt.timedelta(days=1)
QIITA_MAX = 50          # 60/h/IP unauthenticated; leave room for retries by hand
GITHUB_SEARCH_MAX = 25  # 30/min


class FetchError(Exception):
    pass


def usage():
    print("usage: gain-stream topics|discover --since <ISO8601> <sources.yaml>"
          " | budget <sources.yaml>", file=sys.stderr)
    sys.exit(EXIT_USAGE)


def now():
    raw = os.environ.get("GAIN_STREAM_NOW")
    return parse_date(raw) if raw else dt.datetime.now(dt.timezone.utc)


def parse_date(s):
    s = (s or "").strip()
    if not s:
        return None
    try:
        d = dt.datetime.fromisoformat(s.replace("Z", "+00:00"))
    except ValueError:
        try:
            d = email.utils.parsedate_to_datetime(s)
        except (TypeError, ValueError):
            return None
    if d.tzinfo is None:
        d = d.replace(tzinfo=dt.timezone.utc)
    return d.astimezone(dt.timezone.utc)


def iso(d):
    return d.strftime("%Y-%m-%dT%H:%M:%SZ")


def jst_day(d):
    return (d + dt.timedelta(hours=9)).date()


def slug(text):
    s = re.sub(r"[^a-z0-9]+", "_", text.lower()).strip("_")
    return s or hashlib.sha1(text.encode()).hexdigest()[:8]


def fetch(source, query, url=None, gh=None):
    fx = os.environ.get("GAIN_STREAM_FIXTURES")
    if fx:
        path = os.path.join(fx, f"{source}-{slug(query)}")
        if not os.path.isfile(path):
            raise FetchError(f"no fixture {os.path.basename(path)}")
        with open(path, "rb") as f:
            return f.read()
    if gh:
        try:
            r = subprocess.run(["gh", *gh], capture_output=True, timeout=TIMEOUT)
        except (OSError, subprocess.SubprocessError) as e:
            raise FetchError(f"gh: {e}")
        if r.returncode:
            raise FetchError(f"gh exit {r.returncode}: "
                             f"{r.stderr.decode(errors='replace').strip()[:120]}")
        if len(r.stdout) > MAX_BYTES:
            raise FetchError("response too large")
        return r.stdout
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
            body = r.read(MAX_BYTES + 1)
    except urllib.error.HTTPError as e:
        raise FetchError(f"HTTP {e.code}")
    except (urllib.error.URLError, OSError) as e:
        raise FetchError(str(getattr(e, "reason", e)))
    if len(body) > MAX_BYTES:
        raise FetchError("response too large")
    return body


def load_json(raw):
    try:
        return json.loads(raw)
    except ValueError as e:
        raise FetchError(f"bad json: {e}")


def strip_html(s):
    return " ".join(html.unescape(re.sub(r"<[^>]+>", " ", s or "")).split())


def make(kind, topic, section, source, title, url, published, score=None, author=None):
    return {"kind": kind, "topic": topic, "section": section, "source": source,
            "title": " ".join((title or "").split()), "url": url or "",
            "published": published, "score": score, "author": author}


def run_jobs(jobs, since):
    ok = failed = 0
    for j in jobs:
        status = {"source": j["source"], "topic": j["topic"], "query": j["query"]}
        try:
            rows = j["run"]()
            floor = {"since": since, "fixed14": now() - dt.timedelta(days=14),
                     "none": None}[j["window"]]
            if floor is not None and j.get("server"):
                if any(r["published"] and r["published"] < floor - SLACK for r in rows):
                    raise FetchError("window not applied")
            if floor is not None:
                rows = [r for r in rows if r["published"] and r["published"] >= floor]
            rows = [r for r in rows if r["title"] and r["url"]]
        except (FetchError, KeyError, TypeError, AttributeError, ValueError) as e:
            # A response of an unexpected shape fails this fetch only, so the
            # remaining jobs still run and the exit code stays meaningful.
            err = str(e) if isinstance(e, FetchError) else f"bad shape: {type(e).__name__}"
            failed += 1
            print(json.dumps({**status, "ok": False, "count": 0, "error": err},
                             ensure_ascii=False), file=sys.stderr)
            continue
        ok += 1
        for r in rows:
            out = dict(r, published=iso(r["published"]) if r["published"] else None)
            print(json.dumps(out, ensure_ascii=False))
        print(json.dumps({**status, "ok": True, "count": len(rows), "error": None},
                         ensure_ascii=False), file=sys.stderr)
    if failed and not ok:
        return EXIT_ALL_FAILED
    return EXIT_SOME_FAILED if failed else EXIT_OK


# ---- sources ---------------------------------------------------------------

def local(tag):
    return tag.rsplit("}", 1)[-1]


def xml_items(raw):
    try:
        root = ET.fromstring(raw)
    except ET.ParseError as e:
        raise FetchError(f"bad xml: {e}")
    return [e for e in root.iter() if local(e.tag) in ("item", "entry")]


def child_text(e, *names):
    for c in e:
        if local(c.tag) in names and (c.text or "").strip():
            return c.text.strip()
    return ""


def link_of(e):
    for c in e:
        if local(c.tag) == "link":
            if c.get("href") and c.get("rel") in (None, "alternate"):
                return c.get("href")
            if (c.text or "").strip():
                return c.text.strip()
    return ""


def feed_rows(raw, kind, topic, section, source):
    out = []
    for e in xml_items(raw):
        title = child_text(e, "title") or strip_html(child_text(e, "description"))[:80]
        date = parse_date(child_text(e, "published", "pubDate", "date", "updated"))
        count = child_text(e, "bookmarkcount")
        author = child_text(e, "creator", "author") or None
        out.append(make(kind, topic, section, source, title, link_of(e), date,
                        int(count) if count.isdigit() else None, author))
    return out

def hn_query(params):
    return "https://hn.algolia.com/api/v1/search?" + urllib.parse.urlencode(params)


def hn_rows(raw, kind, topic, section, source):
    out = []
    for h in load_json(raw).get("hits", []):
        url = h.get("url") or f"https://news.ycombinator.com/item?id={h.get('objectID')}"
        out.append(make(kind, topic, section, source, h.get("title"), url,
                        parse_date(h.get("created_at")), h.get("points"), h.get("author")))
    return out


def build_topic_jobs(cfg, since):
    jobs = []
    d0 = jst_day(since)
    d1 = jst_day(now())

    def add(source, name, section, q, window, server, fn):
        jobs.append({"source": source, "topic": name, "section": section, "query": q,
                     "window": window, "server": server, "run": fn})

    for t in cfg.get("topics") or []:
        name, section = t.get("name"), t.get("section", "flow")
        for q in t.get("hn") or []:
            def run(q=q, name=name, section=section):
                url = hn_query({"query": q, "tags": "story",
                                "numericFilters": f"created_at_i>{int(since.timestamp())},points>20",
                                "restrictSearchableAttributes": "title", "hitsPerPage": 20})
                return hn_rows(fetch("hn", q, url), "topics", name, section, "hn")
            add("hn", name, section, q, "since", True, run)
        for q in t.get("hatena") or []:
            def run(q=q, name=name, section=section):
                url = (f"https://b.hatena.ne.jp/q/{urllib.parse.quote(q)}?"
                       + urllib.parse.urlencode({"mode": "rss", "sort": "popular",
                                                 "date_begin": d0.isoformat(),
                                                 "date_end": d1.isoformat()}))
                return feed_rows(fetch("hatena", q, url), "topics", name, section, "hatena")
            add("hatena", name, section, q, "since", True, run)
        for q in t.get("qiita") or []:
            def run(q=q, name=name, section=section):
                after = (d0 - dt.timedelta(days=1)).isoformat()
                url = "https://qiita.com/api/v2/items?" + urllib.parse.urlencode(
                    {"per_page": 20, "query": f"tag:{q} created:>{after}"})
                rows = load_json(fetch("qiita", q, url))
                if not isinstance(rows, list):
                    raise FetchError("unexpected qiita response")
                return [make("topics", name, section, "qiita", r.get("title"), r.get("url"),
                             parse_date(r.get("created_at")), r.get("stocks_count"),
                             (r.get("user") or {}).get("id")) for r in rows]
            add("qiita", name, section, q, "since", True, run)
        for q in t.get("zenn") or []:
            def run(q=q, name=name, section=section):
                url = f"https://zenn.dev/topics/{urllib.parse.quote(q)}/feed"
                return feed_rows(fetch("zenn", q, url), "topics", name, section, "zenn")
            add("zenn", name, section, q, "since", False, run)
        for q in t.get("lobsters") or []:
            def run(q=q, name=name, section=section):
                url = f"https://lobste.rs/t/{urllib.parse.quote(q)}.rss"
                return feed_rows(fetch("lobsters", q, url), "topics", name, section, "lobsters")
            add("lobsters", name, section, q, "since", False, run)
        for q in t.get("bluesky") or []:
            def run(q=q, name=name, section=section):
                # api.bsky.app: public.api.bsky.app answers searchPosts with 403.
                # First page only; later pages are reported to need auth.
                url = "https://api.bsky.app/xrpc/app.bsky.feed.searchPosts?" + urllib.parse.urlencode(
                    {"q": q, "sort": "top", "since": iso(since), "limit": 25})
                out = []
                for p in load_json(fetch("bluesky", q, url)).get("posts", []):
                    handle = (p.get("author") or {}).get("handle", "")
                    rkey = (p.get("uri") or "").rsplit("/", 1)[-1]
                    rec = p.get("record") or {}
                    out.append(make("topics", name, section, "bluesky",
                                    (rec.get("text") or "")[:120],
                                    f"https://bsky.app/profile/{handle}/post/{rkey}",
                                    parse_date(rec.get("createdAt")), p.get("likeCount"), handle))
                return out
            add("bluesky", name, section, q, "since", True, run)
    for p in cfg.get("people") or []:
        who = p.get("name")
        if not who:
            continue
        if p.get("blog"):
            def run(p=p, who=who):
                rows = feed_rows(fetch("blog", who, p["blog"]), "topics", None, "people", "blog")
                return [dict(r, author=who) for r in rows]
            add("blog", None, "people", who, "since", False, run)
        if p.get("bluesky"):
            def run(p=p, who=who):
                url = ("https://public.api.bsky.app/xrpc/app.bsky.feed.getAuthorFeed?"
                       + urllib.parse.urlencode({"actor": p["bluesky"], "limit": 30}))
                out = []
                for f in load_json(fetch("bluesky_author", who, url)).get("feed", []):
                    if f.get("reason"):      # a repost, not their own words
                        continue
                    post = f.get("post") or {}
                    rec = post.get("record") or {}
                    rkey = (post.get("uri") or "").rsplit("/", 1)[-1]
                    out.append(make("topics", None, "people", "bluesky_author",
                                    (rec.get("text") or "")[:120],
                                    f"https://bsky.app/profile/{p['bluesky']}/post/{rkey}",
                                    parse_date(rec.get("createdAt")), post.get("likeCount"), who))
                return out
            add("bluesky_author", None, "people", who, "since", False, run)
        if p.get("mastodon"):
            def run(p=p, who=who):
                rows = feed_rows(fetch("mastodon", who, p["mastodon"]), "topics", None,
                                 "people", "mastodon")
                return [dict(r, author=who) for r in rows]
            add("mastodon", None, "people", who, "since", False, run)
    return jobs


AGO_RE = re.compile(r"(\d+)\s+(minute|hour|day|week|month|year)s?\s+ago")
AGO_UNIT = {"minute": 60, "hour": 3600, "day": 86400, "week": 7 * 86400,
            "month": 30 * 86400, "year": 365 * 86400}


def ollama_rows(raw):
    text = raw.decode("utf-8", errors="replace")
    out = []
    for part in text.split('<a href="/library/')[1:]:
        name = part.split('"', 1)[0]
        desc = re.search(r'<p class="max-w-lg[^"]*">(.*?)</p>', part, re.S)
        ago = AGO_RE.search(part)
        published = (now() - dt.timedelta(seconds=int(ago.group(1)) * AGO_UNIT[ago.group(2)])
                     if ago else None)
        title = name + (" — " + strip_html(desc.group(1)) if desc else "")
        out.append(make("discover", None, None, "ollama", title,
                        f"https://ollama.com/library/{name}", published))
    if not out:
        raise FetchError("no models parsed")
    # Undated rows are all dropped by the "since" window; with none dated the
    # fetch would report ok with 0 items when the "N hours ago" wording changes.
    if not any(r["published"] for r in out):
        raise FetchError("no dates parsed")
    return out


def build_discover_jobs(cfg, since):
    d = cfg.get("discover") or {}
    jobs = []

    def add(source, q, window, server, fn):
        jobs.append({"source": source, "topic": None, "section": None, "query": q,
                     "window": window, "server": server, "run": fn})

    def hn(source, tags, min_points, q):
        def run():
            url = hn_query({"tags": tags, "hitsPerPage": 30,
                            "numericFilters": f"created_at_i>{int(since.timestamp())},points>{min_points}"})
            return hn_rows(fetch(source, q, url), "discover", None, None, source)
        add(source, q, "since", True, run)

    if "hn_front" in d:
        hn("hn_front", "story", (d["hn_front"] or {}).get("min_points", 200), "front")
    if "show_hn" in d:
        hn("show_hn", "show_hn", (d["show_hn"] or {}).get("min_points", 80), "show")
    if "hatena_it" in d:
        floor = (d["hatena_it"] or {}).get("min_bookmarks", 100)
        def run(floor=floor):
            rows = feed_rows(fetch("hatena_it", "it", "https://b.hatena.ne.jp/hotentry/it.rss"),
                             "discover", None, None, "hatena_it")
            return [r for r in rows if (r["score"] or 0) >= floor]
        add("hatena_it", "it", "none", False, run)
    if "zenn_trend" in d:
        limit = (d["zenn_trend"] or {}).get("limit", 10)
        def run(limit=limit):
            # unofficial API; order=liked_count is silently ignored, weekly works
            url = f"https://zenn.dev/api/articles?order=weekly&count={int(limit)}"
            return [make("discover", None, None, "zenn_trend", a.get("title"),
                         "https://zenn.dev" + (a.get("path") or ""),
                         parse_date(a.get("published_at")), a.get("liked_count"),
                         (a.get("user") or {}).get("username"))
                    for a in load_json(fetch("zenn_trend", "weekly", url)).get("articles", [])]
        add("zenn_trend", "weekly", "none", False, run)
    if "qiita_popular" in d:
        limit = (d["qiita_popular"] or {}).get("limit", 10)
        def run(limit=limit):
            rows = feed_rows(fetch("qiita_popular", "popular", "https://qiita.com/popular-items/feed"),
                             "discover", None, None, "qiita_popular")
            return rows[:int(limit)]
        add("qiita_popular", "popular", "none", False, run)
    if "github_new" in d:
        stars = (d["github_new"] or {}).get("min_stars", 300)
        def run(stars=stars):
            after = (now() - dt.timedelta(days=14)).date().isoformat()
            raw = fetch("github_new", "new", gh=["api", "-X", "GET", "search/repositories",
                                                 "-f", f"q=created:>{after} stars:>{stars}",
                                                 "-f", "sort=stars", "-f", "per_page=20"])
            return [make("discover", None, None, "github_new",
                         f"{r.get('full_name')} — {r.get('description') or ''}".rstrip(" —"),
                         r.get("html_url"), parse_date(r.get("created_at")),
                         r.get("stargazers_count"), (r.get("owner") or {}).get("login"))
                    for r in load_json(raw).get("items", [])]
        add("github_new", "new", "fixed14", True, run)
    if "ollama_newest" in d:
        limit = (d["ollama_newest"] or {}).get("limit", 10)
        def run(limit=limit):
            return ollama_rows(fetch("ollama", "newest", "https://ollama.com/search?o=newest"))[:int(limit)]
        add("ollama", "newest", "since", False, run)
    if "hf_trending" in d:
        hf = d["hf_trending"] or {}
        for f in hf.get("filters") or ["text-generation"]:
            def run(f=f, limit=hf.get("limit", 10)):
                url = "https://huggingface.co/api/models?" + urllib.parse.urlencode(
                    {"sort": "trendingScore", "limit": int(limit), "filter": f})
                return [make("discover", None, None, "hf", m.get("id"),
                             f"https://huggingface.co/{m.get('id')}",
                             parse_date(m.get("createdAt")), m.get("trendingScore"))
                        for m in load_json(fetch("hf", f, url))]
            add("hf", f, "none", False, run)
    return jobs


def count_requests(cfg):
    qiita = sum(len(t.get("qiita") or []) for t in cfg.get("topics") or [])
    gh_search = 1 if (cfg.get("discover") or {}).get("github_new") else 0
    total = sum(len(t.get(k) or []) for t in cfg.get("topics") or []
                for k in SOURCE_KEYS)
    total += sum(bool(p.get(k)) for p in cfg.get("people") or []
                 for k in PEOPLE_KEYS)
    total += len(cfg.get("discover") or {})
    return {"requests": total, "qiita": qiita, "github_search": gh_search}


SOURCE_KEYS = ("hn", "hatena", "qiita", "zenn", "lobsters", "bluesky")
PEOPLE_KEYS = ("blog", "bluesky", "mastodon")


def cfg_error(cfg):
    """What is wrong with the shape of sources.yaml, or None."""
    topics = cfg.get("topics")
    if topics is not None and not isinstance(topics, list):
        return "topics must be a list"
    for i, t in enumerate(topics or []):
        if not isinstance(t, dict):
            return f"topics[{i}] must be a mapping"
        if not isinstance(t.get("name"), str):
            return f"topics[{i}].name must be a string"
        for k in SOURCE_KEYS:
            v = t.get(k)
            if v is not None and not (isinstance(v, list)
                                      and all(isinstance(q, str) for q in v)):
                return f"topics[{i}].{k} must be a list of strings"
    people = cfg.get("people")
    if people is not None and not isinstance(people, list):
        return "people must be a list"
    for i, p in enumerate(people or []):
        if not isinstance(p, dict) or not isinstance(p.get("name"), str):
            return f"people[{i}] must be a mapping with a string name"
        for k in PEOPLE_KEYS:
            v = p.get(k)
            if v is not None and not isinstance(v, str):
                return f"people[{i}].{k} must be a string"
    discover = cfg.get("discover")
    if discover is not None and not isinstance(discover, dict):
        return "discover must be a mapping"
    for k, v in (discover or {}).items():
        # unknown keys are allowed (ignored), but each value has a fixed shape
        if v is not None and not isinstance(v, dict):
            return f"discover.{k} must be a mapping"
    filters = ((discover or {}).get("hf_trending") or {}).get("filters")
    if filters is not None and not (isinstance(filters, list)
                                    and all(isinstance(f, str) for f in filters)):
        return "discover.hf_trending.filters must be a list of strings"
    return None


def load_cfg(path):
    try:
        with open(path, encoding="utf-8") as f:
            cfg = yaml.safe_load(f) or {}
    except OSError:
        print(f"gain-stream: no sources file at {path}", file=sys.stderr)
        sys.exit(EXIT_ALL_FAILED)
    except yaml.YAMLError as e:
        print(f"gain-stream: sources.yaml is not valid YAML: {e}", file=sys.stderr)
        sys.exit(EXIT_ALL_FAILED)
    if not isinstance(cfg, dict):
        print("gain-stream: sources.yaml must be a mapping", file=sys.stderr)
        sys.exit(EXIT_ALL_FAILED)
    err = cfg_error(cfg)
    if err:
        print(f"gain-stream: sources.yaml: {err}", file=sys.stderr)
        sys.exit(EXIT_ALL_FAILED)
    return cfg


def main(argv):
    if len(argv) == 2 and argv[0] == "budget":
        c = count_requests(load_cfg(argv[1]))
        print(json.dumps(c))
        over = c["qiita"] > QIITA_MAX or c["github_search"] > GITHUB_SEARCH_MAX
        return EXIT_ALL_FAILED if over else EXIT_OK
    if len(argv) != 4 or argv[0] not in ("topics", "discover") or argv[1] != "--since":
        usage()
    since = parse_date(argv[2])
    if since is None or not re.match(r"\d{4}-\d{2}-\d{2}T", argv[2]):
        usage()
    cfg = load_cfg(argv[3])
    build = build_topic_jobs if argv[0] == "topics" else build_discover_jobs
    return run_jobs(build(cfg, since), since)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
