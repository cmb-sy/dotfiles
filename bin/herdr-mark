#!/bin/bash
# Put a marker on the focused herdr session, chosen from a list. Typing a
# symbol the list does not have adds it to the set.
#
# A row in the agents panel reads "<workspace label> · <tab label>", one row per
# agent, so a session is a tab: marking the workspace marks every session under
# it. But the panel drops the tab half when a workspace holds a single tab
# (AITF and dotfiles both have a tab named "1"; only dotfiles shows it), so a
# tab-level mark would be invisible there. Hence: mark the tab when the
# workspace has several, the workspace when it has one. Either way exactly one
# row changes.
#
# herdr has no pin or star. Names are the only per-row field that survives a
# server restart (session.json custom_name), so the marker is a name prefix.
#
# Bound to Cmd+Opt+M in terminal/herdr/config.toml, which opens a throwaway
# pane so fzf has a terminal to draw in. The pane lives in the current tab, so
# the focused workspace and tab are still the ones the marker should land on.
#
#   herdr-mark                 pick from the list, or type a new marker
#   herdr-mark set <marker>    apply one marker without the picker
#   herdr-mark off             remove whatever marker is there
#   herdr-mark forget <marker> retire a marker from the list
#
# In the picker, Ctrl-D retires the highlighted marker instead of applying it.

set -euo pipefail

_here="${BASH_SOURCE[0]%/*}"
[ "$_here" = "${BASH_SOURCE[0]}" ] && _here=.
HERE="$(cd -- "$_here" && pwd)"
. "$HERE/lib/herdr-marks.sh" || exit 1
SORT_BIN="${HERDR_SORT_BIN:-$HERE/herdr-sort}"

CLEAR_KEY="✕"

action="${1:-pick}"

die() {
  osascript -e "display notification \"$1\" with title \"herdr-mark\"" >/dev/null 2>&1 || true
  printf 'herdr-mark: %s\n' "$1" >&2
  exit 1
}

# The key binding runs in a throwaway pane that closes the moment this exits,
# so an error on screen is gone before it can be read. One overwritten line
# tells "the key never fired" from "it fired and failed".
BREADCRUMB="${HERDR_MARK_BREADCRUMB:-/private/tmp/herdr-mark.last}"
printf '%s invoked action=%s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$action" \
  >"$BREADCRUMB" 2>/dev/null || true

# Strip any known marker, offered or retired, from the front of a label.
strip_mark() {
  local label="$1" m
  while IFS= read -r m; do
    [ -n "$m" ] || continue
    if [ "${label#"$m"}" != "$label" ]; then
      printf '%s' "${label#"$m"}"
      return 0
    fi
  done <<EOF
$(marks_strippable)
EOF
  printf '%s' "$label"
}

case "$action" in
  pick | off) ;;
  set | forget)
    [ $# -ge 2 ] || die "$action needs a marker (one of: $(marks_entries | cut -f1 | tr '\n' ' '))"
    marks_is_offered "$2" || die "unknown marker: $2 (expected one of: $(marks_entries | cut -f1 | tr '\n' ' '))"
    ;;
  *) die "unknown action: $action (expected pick, set, forget, or off)" ;;
esac

# Retiring touches only the set, never a session name, so it is done before
# any of the workspace lookups below and exits there.
if [ "$action" = forget ]; then
  marks_remove "$2" || die "could not retire $2"
  exit 0
fi

command -v herdr >/dev/null 2>&1 || die "herdr not found on PATH"

# Rows, not tabs. The panel lists one row per agent, so a workspace with three
# tabs but one agent is a single row -- and a single row can carry the marker on
# the workspace, where it sits at the left edge instead of after the separator.
ws_line="$(herdr workspace list 2>/dev/null | python3 -c '
import json, subprocess, sys
try:
    workspaces = json.load(sys.stdin)["result"]["workspaces"]
except Exception:
    sys.exit(1)
focused = next((w for w in workspaces if w.get("focused")), None)
if focused is None:
    sys.exit(0)
try:
    agents = json.loads(subprocess.run(["herdr", "agent", "list"],
                                       capture_output=True, text=True).stdout)["result"]["agents"]
    rows = sum(1 for a in agents if a.get("workspace_id") == focused["workspace_id"])
except Exception:
    rows = 0
# 0 when agent list could not be read. That falls on the same side of the
# "more than one row" test as 1 does, so a failure here degrades to marking
# the workspace rather than to marking nothing.
print("%s\t%s\t%s" % (focused["workspace_id"], rows, focused.get("label", "")))
' 2>/dev/null)" || die "cannot read the workspace list (is the herdr server running?)"
[ -n "$ws_line" ] || die "no focused workspace"

ws_id="$(printf '%s' "$ws_line" | cut -f1)"
row_count="$(printf '%s' "$ws_line" | cut -f2)"
ws_label="$(printf '%s' "$ws_line" | cut -f3-)"
[ -n "$ws_id" ] || die "workspace list returned no id"
[ -n "$ws_label" ] || die "focused workspace $ws_id has no label"
tab_line="$(herdr tab list --workspace "$ws_id" 2>/dev/null | python3 -c '
import json, sys
try:
    tabs = json.load(sys.stdin)["result"]["tabs"]
except Exception:
    sys.exit(1)
for t in tabs:
    if t.get("focused"):
        print("%s\t%s" % (t["tab_id"], t.get("label", "")))
        break
' 2>/dev/null)" || die "cannot read the tab list for $ws_id"
[ -n "$tab_line" ] || die "no focused tab in $ws_id"

tab_id="$(printf '%s' "$tab_line" | cut -f1)"
tab_label="$(printf '%s' "$tab_line" | cut -f2-)"
[ -n "$tab_id" ] || die "tab list returned no id"
[ -n "$tab_label" ] || die "focused tab $tab_id has no label"

ws_base="$(strip_mark "$ws_label")"
tab_base="$(strip_mark "$tab_label")"
# A label that is nothing but a marker would rename to the empty string.
[ -n "$ws_base" ] || die "label of $ws_id is only a marker; rename it by hand"
[ -n "$tab_base" ] || die "label of $tab_id is only a marker; rename it by hand"

# One row means the workspace maps to exactly that row, so the marker goes on
# the workspace name: it shows at the left edge and reaches nothing else. With
# several rows the workspace name is shared, so the marker has to go on the tab
# even though that puts it after the separator.
if [ "$row_count" -gt 1 ]; then target=tab; else target=workspace; fi

if [ "$action" = pick ]; then
  command -v fzf >/dev/null 2>&1 || die "fzf not found on PATH"
  current="$(if [ "$target" = tab ]; then printf '%s' "$tab_label"; else printf '%s' "$ws_label"; fi)"
  menu="$(marks_entries | awk -F'\t' '{ if ($2 == "") print $1; else print $1 " " $2 }')"
  menu="${menu}
${CLEAR_KEY} 印を外す"

  # --print-query so a symbol that matches nothing is still readable: that is
  # how a new marker is added, without a separate "add" entry to find.
  set +e
  picked="$(printf '%s\n' "$menu" | fzf --print-query --expect=ctrl-d \
    --prompt="$current > " --reverse --height=100% --no-info \
    --header='Enter で付ける / 打ち込んで Enter で追加 / Ctrl-D で一覧から削除')"
  rc=$?
  set -e
  [ "$rc" -eq 130 ] && exit 0

  # --print-query then --expect: line 1 is what was typed, line 2 the key that
  # closed the picker (empty for Enter), line 3 the highlighted row.
  query="$(printf '%s' "$picked" | sed -n '1p')"
  pressed="$(printf '%s' "$picked" | sed -n '2p')"
  chosen="$(printf '%s' "$picked" | sed -n '3p')"

  if [ "$pressed" = "ctrl-d" ]; then
    [ -n "$chosen" ] || exit 0
    doomed="${chosen%% *}"
    [ "$doomed" != "$CLEAR_KEY" ] || die "印を外す は一覧から削除できません"
    marks_remove "$doomed" || die "could not retire $doomed"
    exit 0
  fi

  if [ -n "$chosen" ]; then
    chosen_mark="${chosen%% *}"
    if [ "$chosen_mark" = "$CLEAR_KEY" ]; then
      want=""
    else
      marks_is_offered "$chosen_mark" || die "picker returned an unknown marker: $chosen_mark"
      want="$chosen_mark"
    fi
  elif [ -n "$query" ]; then
    # Nothing matched: treat what was typed as a marker to add.
    printf '%s の説明（空のままで可）: ' "$query" >&2
    read -r new_label || new_label=""
    marks_add "$query" "$new_label" || die "could not add $query to the set"
    want="$query"
  else
    exit 0
  fi
elif [ "$action" = off ]; then
  want=""
else
  want="$2"
fi

rename_ws() {
  if [ "$1" != "$ws_label" ]; then
    herdr workspace rename "$ws_id" "$1" >/dev/null || die "rename failed for $ws_id"
  fi
}
rename_tab() {
  if [ "$1" != "$tab_label" ]; then
    herdr tab rename "$tab_id" "$1" >/dev/null || die "rename failed for $tab_id"
  fi
}

# The non-target is always cleared: a marker left on the workspace would show
# on every sibling session, which is the bug this replaced.
if [ "$target" = tab ]; then
  rename_tab "${want}${tab_base}"
  rename_ws "$ws_base"
else
  rename_ws "${want}${ws_base}"
  rename_tab "$tab_base"
fi

# Float the marked rows to the top, so the order follows the markers without a
# second key. Best-effort: the marker is already written, and failing here would
# report the mark itself as failed.
[ -x "$SORT_BIN" ] && "$SORT_BIN" >/dev/null 2>&1 || true
