#!/bin/bash
# A live board of herdr tabs, one row per issue or tab under a heading per
# repository: the issue or label, the marker the user put on the tab
# (herdr-mark) with its meaning, the last activity and a summary. Enter on the
# cursor row, or a click on any row, focuses that tab.
#
#   herdr-issues          redraw every 5 s; up/down or j/k move the cursor;
#                         q or Ctrl-C quits
#   herdr-issues --once   print the board once, lines cut at $COLUMNS
#                         (160 when unset; the terminal width on a tty)
#   herdr-issues --jump   focus the board's workspace, first creating it or
#                         restarting a stopped board; there is only ever one
#
# Nothing is stored but gh answers: every redraw joins herdr's tab, agent and
# workspace lists with the transcripts (<root>/projects/*/<session>.jsonl).
# A tab's issue is "#N" in its label, else a word of 2-5 digits; its repository
# is the origin of an agent's cwd, and tabs on one issue of one repository
# share a row. The state is only the marker leading the tab label, as long as
# it is in the user's set; nothing else decides it. The summary is the
# conclusion of Claude's last reply heading ("## 【完了】 結論"), else the rest
# of the label beside the issue's title. Rows and repositories go newest first;
# rows quiet for over 14 days collapse into one count. Tabs without a Claude
# agent and the board's own tab are left out.
#
# Overrides: HERDR_BIN, GH_BIN, HERDR_ISSUES_ROOTS (colon-separated dirs
# holding projects/), HERDR_ISSUES_NOW (epoch seconds), HERDR_ISSUES_CACHE
# (gh answers, kept 10 min), HERDR_MARKS_FILE (the markers, "<marker>\t<meaning>"
# lines; default ~/.local/state/herdr/marks.tsv, shared with herdr-mark),
# HERDR_ISSUES_REPOS ("<workspace> <owner/repo>" lines
# for checkouts without a remote; default ~/.config/dotfiles-local/herdr-issues-repos),
# HERDR_ISSUES_SOCKET (herdr's API socket, used to keep the board's
# workspace first), HERDR_ISSUES_SELF (tab to leave out; by default
# the tab of $HERDR_PANE_ID).

set -euo pipefail

usage() {
  echo "usage: herdr-issues [--once | --jump]" >&2
  exit 2
}

mode=live
while [ $# -gt 0 ]; do
  case "$1" in
    --once) mode=once ;;
    --jump) mode=jump ;;
    *) usage ;;
  esac
  shift
done

herdr="${HERDR_BIN:-herdr}"
if ! command -v "$herdr" >/dev/null 2>&1; then
  echo "herdr-issues: herdr not found" >&2
  exit 0
fi

IFS= read -r -d '' program <<'PY' || true
import json, os, re, select, signal, subprocess, sys, termios, time, tty, unicodedata
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone

HERDR = os.environ.get("HERDR_BIN") or "herdr"
GH = os.environ.get("GH_BIN") or "gh"
HOME = os.path.expanduser("~")
ROOTS = [r for r in (os.environ.get("HERDR_ISSUES_ROOTS")
                     or HOME + "/.claude-private:" + HOME + "/.claude-work").split(":") if r]
# "<workspace> <owner/repo>" per line, for checkouts without an origin remote.
REPOS = os.environ.get("HERDR_ISSUES_REPOS") or os.path.join(
    HOME, ".config", "dotfiles-local", "herdr-issues-repos")
CACHE = os.environ.get("HERDR_ISSUES_CACHE") or os.path.join(HOME, ".cache", "herdr-issues")
# The user's markers, "<marker><TAB><meaning>" per line (bin/lib/herdr-marks.sh).
MARKS_FILE = os.environ.get("HERDR_MARKS_FILE") or os.path.join(
    HOME, ".local", "state", "herdr", "marks.tsv")
DAY = 86400
STALE_DAYS = 14
CACHE_TTL = 600
# A failed gh lookup is retried after this long, not on every redraw.
RETRY_AFTER = 60

# The heading Claude's replies start with, "## 【完了】 [作業名] 結論"; only
# the conclusion is used, so any tag and an absent [作業名] are fine.
HEADING = re.compile(r"^##\s*【[^】\n]+】\s*(?:\[[^\]\n]*\]\s*)?(.*?)\s*$", re.M)
HEADING_MARK = "【".encode()
# How far back from the end of a transcript to look for the last reply heading.
REPLY_SCAN = 2 << 20
# A long tab label gives way so the other columns stay put.
ISSUE_WIDTH = 24
# Repository headings on a screen: bold bright white on one dark blue band.
HEADING_STYLE = "1;97;48;5;24"
# The cursor row: bold reverse video across the screen.
CURSOR_STYLE = "1;7"

# "#123" anywhere, else a word of 2-5 digits ("2386 ✅"). "1" or "debug2" is no issue.
HASH_ISSUE = re.compile(r"#([1-9][0-9]{0,5})(?![0-9])")
BARE_ISSUE = re.compile(r"(?<!\S)([1-9][0-9]{1,4})(?!\S)")
REMOTE = re.compile(r"[:/]([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+?)(?:\.git)?/?$")

BIDI = {chr(c) for c in (0x061C, 0x200E, 0x200F, *range(0x202A, 0x202F), *range(0x2066, 0x206A))}
# What emoji are built from besides symbols: joiner, keycap, variation selectors.
EMOJI_PARTS = {chr(c) for c in (0x200D, 0x20E3, 0xFE0E, 0xFE0F)}

REFRESH = 5
# SGR mouse reports (ESC [ < button ; column ; row, then M or m); up and down
# arrows in any form a terminal sends them, modifiers included (ESC [ A,
# ESC [ 1 ; 9 A, ESC O A); other escapes; single keys.
INPUT = re.compile(rb"\x1b\[<(\d+);(\d+);(\d+)([Mm])|\x1b(?:\[[0-9;]*|O)([AB])"
                   rb"|\x1b(?:\[[0-?]*[ -/]*[@-~]|[^\[])|(.)", re.S)
# An escape sequence cut off by the end of a read, finished by the next one.
PARTIAL = re.compile(rb"\x1b(?:\[[0-?]*[ -/]*|O)?$")


class HerdrError(Exception):
    pass


def now():
    try:
        return int(os.environ["HERDR_ISSUES_NOW"])
    except (KeyError, ValueError):
        return time.time()


def herdr(*args):
    try:
        p = subprocess.run([HERDR, *args], stdin=subprocess.DEVNULL, capture_output=True,
                           encoding="utf-8", errors="replace", timeout=10)
    except (OSError, subprocess.SubprocessError) as e:
        raise HerdrError(str(e))
    if p.returncode != 0:
        raise HerdrError("herdr %s failed" % " ".join(args))
    try:
        return json.loads(p.stdout)["result"]
    except (ValueError, KeyError, TypeError):
        raise HerdrError("unexpected herdr output")


def entries(key, *args):
    result = herdr(*args)
    items = result.get(key) if isinstance(result, dict) else None
    if not isinstance(items, list):
        raise HerdrError("unexpected herdr output")
    return [i for i in items if isinstance(i, dict)]


def text(value):
    return value if isinstance(value, str) else ""


def clean(s):
    # Labels, titles and headings reach a raw terminal: no control, bidi or
    # lone surrogate characters, and whitespace runs become one space.
    return " ".join("".join(" " if unicodedata.category(c) in ("Cc", "Cs") or c in BIDI else c
                            for c in s).split())


def plain(label):
    # A label without the user's marker emoji (🥉 📤 ✅ 🔥) or other symbols.
    return " ".join("".join(c for c in label if c not in EMOJI_PARTS
                            and unicodedata.category(c) not in ("So", "Sk", "Cn")).split())


def self_tab():
    # The board's own tab, left out of the board.
    if "HERDR_ISSUES_SELF" in os.environ:
        return os.environ["HERDR_ISSUES_SELF"]
    pane = os.environ.get("HERDR_PANE_ID")
    if not pane:
        return ""
    try:
        return text(herdr("pane", "get", pane)["pane"]["tab_id"])
    except (HerdrError, KeyError, TypeError):
        return ""


def session(agent):
    s = agent.get("agent_session")
    v = s.get("value") if isinstance(s, dict) else None
    return v if isinstance(v, str) and v else None


def epoch(ts):
    if not isinstance(ts, str):
        return None
    try:
        d = datetime.fromisoformat(ts[:-1] + "+00:00" if ts.endswith("Z") else ts)
    except ValueError:
        return None
    return (d if d.tzinfo else d.replace(tzinfo=timezone.utc)).timestamp()


def last_activity(path):
    # The last line carrying a "timestamp", read from the end of the file.
    # None when no line has one, or when that last one cannot be read.
    with open(path, "rb") as f:
        pos = f.seek(0, os.SEEK_END)
        carry = b""
        while pos > 0:
            step = min(65536, pos)
            pos -= step
            f.seek(pos)
            lines = (f.read(step) + carry).split(b"\n")
            # Unless this read reached the start, its first line is partial.
            carry = lines.pop(0) if pos > 0 else b""
            for line in reversed(lines):
                if b'"timestamp"' not in line:
                    continue
                try:
                    record = json.loads(line)
                except ValueError:
                    # A truncated last line: older lines would understate activity.
                    return None
                try:
                    ts = record["timestamp"]
                except (KeyError, TypeError):
                    continue
                return epoch(ts)
    return None


def activity(path):
    try:
        return last_activity(path)
    except OSError:
        return None


def transcripts(sessions):
    # Session id -> its transcripts. Ids are compared with file names, never
    # joined into a path, so an id holding "/" or ".." matches nothing.
    found = {}
    for root in ROOTS:
        try:
            projects = [d.path for d in os.scandir(os.path.join(root, "projects")) if d.is_dir()]
        except OSError:
            continue
        for project in projects:
            try:
                files = list(os.scandir(project))
            except OSError:
                continue
            for f in files:
                sid, ext = os.path.splitext(f.name)
                if ext == ".jsonl" and sid in sessions:
                    found.setdefault(sid, []).append(f.path)
    return found


def reply_heading(record):
    # The conclusion in the heading of a reply by the session's own Claude, or None.
    if not isinstance(record, dict) or record.get("type") != "assistant" \
            or record.get("isSidechain"):
        return None
    message = record.get("message")
    content = message.get("content") if isinstance(message, dict) else None
    if isinstance(content, str):
        content = [{"type": "text", "text": content}]
    for part in content if isinstance(content, list) else ():
        if isinstance(part, dict) and part.get("type") == "text" and isinstance(part.get("text"), str):
            m = HEADING.search(part["text"])
            if m:
                return clean(m.group(1).replace("`", ""))
    return None


def scan_reply(path, size):
    start = max(0, size - REPLY_SCAN)
    try:
        with open(path, "rb") as f:
            f.seek(start)
            lines = f.read(size - start).split(b"\n")
    except OSError:
        return None
    for line in reversed(lines[1:] if start else lines):
        # Most lines are tool traffic: skip them unparsed.
        if b'"assistant"' not in line or HEADING_MARK not in line:
            continue
        try:
            found = reply_heading(json.loads(line))
        except ValueError:
            continue
        # The newest heading decides, even when its conclusion is empty.
        if found is not None:
            return found
    return None


replies = {}


def last_reply(path):
    # Rescanned only when the transcript changed since the last redraw.
    try:
        st = os.stat(path)
    except OSError:
        return None
    stamp = (st.st_size, st.st_mtime_ns)
    if path not in replies or replies[path][0] != stamp:
        replies[path] = (stamp, scan_reply(path, st.st_size))
    return replies[path][1]


def markers():
    # [(marker, meaning)] from the user's set, longest marker first so one is
    # never taken for a shorter marker it starts with.
    try:
        with open(MARKS_FILE, encoding="utf-8", errors="replace") as f:
            pairs = [line.rstrip("\n").split("\t", 1) for line in f]
    except OSError:
        return []
    found = [(clean(p[0]), clean(p[1]) if len(p) > 1 else "") for p in pairs]
    return sorted((p for p in found if p[0]), key=lambda p: -len(p[0]))


def split_marker(label, marks):
    # ("<emoji...>" or "", the label without them). A marker from the set may
    # lead the label; emoji words anywhere (herdr-mark leads, older habits
    # trail: "2413 🥇 📤") all show, without their meanings.
    found = []
    for marker, _ in marks:
        if label.startswith(marker):
            found, label = [marker], label[len(marker):]
            break
    words = []
    for w in label.split():
        (found if not plain(w) else words).append(w)
    return " ".join(found), " ".join(words)


def issue_number(label):
    m = HASH_ISSUE.search(label) or BARE_ISSUE.search(label)
    return int(m.group(1)) if m else None


slugs = {}


def repo_map():
    # Workspace name -> "owner/repo" from REPOS; malformed lines are skipped.
    out = {}
    try:
        with open(REPOS, encoding="utf-8", errors="replace") as f:
            for line in f:
                parts = line.split()
                if len(parts) == 2 and not parts[0].startswith("#") \
                        and REMOTE.search("/" + parts[1]) \
                        and all(x.strip(".") for x in parts[1].split("/")):
                    out[parts[0]] = parts[1]
    except OSError:
        pass
    return out


def repo_of(cwd):
    # "owner/name" of the origin remote of cwd, or None.
    if not cwd:
        return None
    if cwd not in slugs:
        slugs[cwd] = None
        try:
            p = subprocess.run(["git", "-C", cwd, "remote", "get-url", "origin"],
                               stdin=subprocess.DEVNULL, capture_output=True,
                               encoding="utf-8", errors="replace", timeout=5)
        except (OSError, subprocess.SubprocessError):
            return None
        m = REMOTE.search(p.stdout.strip()) if p.returncode == 0 else None
        # Owner and name also name the cache file, so "." and ".." are refused.
        if m and all(part.strip(".") for part in m.groups()):
            slugs[cwd] = "%s/%s" % m.groups()
    return slugs[cwd]


def valid(info):
    if isinstance(info, dict) and isinstance(info.get("title"), str):
        return {"title": info["title"]}
    return None


def cached(path):
    try:
        if time.time() - os.stat(path).st_mtime >= CACHE_TTL:
            return None
        with open(path, encoding="utf-8") as f:
            return valid(json.load(f))
    except (OSError, ValueError):
        return None


def store(path, info):
    tmp = "%s.%d.tmp" % (path, os.getpid())
    try:
        os.makedirs(CACHE, exist_ok=True)
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(info, f, ensure_ascii=False)
        os.replace(tmp, path)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def fetch(repo, number):
    try:
        p = subprocess.run([GH, "issue", "view", str(number), "--repo", repo, "--json", "title"],
                           stdin=subprocess.DEVNULL, capture_output=True,
                           encoding="utf-8", errors="replace", timeout=20)
        return valid(json.loads(p.stdout)) if p.returncode == 0 else None
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


failed = {}


def issue(key):
    # The issue's title, or None when gh cannot tell.
    repo, number = key
    path = os.path.join(CACHE, "%s_%d.json" % (repo.replace("/", "_"), number))
    info = cached(path)
    if info or time.time() - failed.get(path, 0) < RETRY_AFTER:
        return info
    info = fetch(repo, number)
    if info:
        store(path, info)
    else:
        failed[path] = time.time()
    return info


def build(t, me):
    # Fresh rows and how many went stale.
    tabs = entries("tabs", "tab", "list")
    agents = entries("agents", "agent", "list")
    workspaces = entries("workspaces", "workspace", "list")

    names = {}
    for w in workspaces:
        # A workspace label may start with an emoji the user put there.
        names[text(w.get("workspace_id"))] = re.sub(r"^\W+", "", clean(text(w.get("label"))))
    members = {}
    for a in agents:
        members.setdefault(text(a.get("tab_id")), []).append(a)
    files = transcripts({session(a) for a in agents} - {None})
    mapped = repo_map()
    marks = markers()

    groups = {}
    for tab in tabs:
        tid = text(tab.get("tab_id"))
        if not tid or tid == me or tid not in members:
            continue
        crew = members[tid]
        # The newest transcript of the tab's agents gives its time and reply.
        last, path = None, None
        for a in crew:
            for p in files.get(session(a), ()):
                at = activity(p)
                if path is None:
                    path = p
                if at is not None and (last is None or at > last):
                    last, path = at, p
        # The marker leads the label, so the issue is read from what follows it.
        marker, label = split_marker(clean(text(tab.get("label"))), marks)
        wid = text(tab.get("workspace_id"))
        number = issue_number(label)
        repo = None
        if number:
            repo = next((r for r in (repo_of(text(a.get("cwd"))) for a in crew) if r), None) \
                or mapped.get(names.get(wid) or "")
        # Tabs on the same issue of the same repository share a row.
        key = (repo or "workspace " + wid, number) if number else ("tab", tid)
        groups.setdefault(key, []).append({
            "tab": tid,
            "label": plain(label),
            "marker": marker,
            "last": last,
            "path": path,
            "ws": names.get(wid) or "−",
            "number": number,
            "repo": repo,
        })

    rows = []
    for group in groups.values():
        # A row shows a tab the user marked if any, the newest among them; a click goes there.
        lead = max(group, key=lambda e: (bool(e["marker"]), e["last"] is not None, e["last"] or 0))
        known = [e["last"] for e in group if e["last"] is not None]
        rows.append(dict(lead, last=max(known) if known else None, count=len(group)))

    cutoff = t - STALE_DAYS * DAY
    fresh = [r for r in rows if r["last"] is None or r["last"] >= cutoff]
    lookups = sorted({(r["repo"], r["number"]) for r in fresh if r["repo"]})
    with ThreadPoolExecutor(max_workers=8) as pool:
        infos = dict(zip(lookups, pool.map(issue, lookups)))
    for r in fresh:
        info = infos.get((r["repo"], r["number"]))
        conclusion = last_reply(r["path"]) if r["path"] else None
        if r["number"]:
            r["ident"] = "#%d" % r["number"] + (" (%dタブ)" % r["count"] if r["count"] > 1 else "")
            # The label stays beside the title so a title from the wrong repository shows.
            rest = " ".join(w for w in r["label"].split() if issue_number(w) != r["number"])
            fallback = " — ".join(x for x in (rest, clean(info["title"]) if info else "") if x)
        else:
            # The label is already the row's name.
            r["ident"], fallback = r["label"] or "−", ""
        r["summary"] = conclusion or fallback
    return fresh, len(rows) - len(fresh)


def newest(r):
    # Sort key: the most recent activity first, unknown times last.
    return r["last"] is None, -(r["last"] or 0)


def sections(rows):
    # [(repository, rows)], newest first both ways: a repository goes by its
    # newest row.
    by = {}
    for r in rows:
        by.setdefault(r["ws"], []).append(r)
    for group in by.values():
        group.sort(key=newest)
    return sorted(by.items(), key=lambda item: newest(item[1][0]))


def cell_width(c):
    if unicodedata.category(c) in ("Mn", "Me", "Cf"):
        return 0
    return 2 if unicodedata.east_asian_width(c) in ("W", "F") else 1


def width(s):
    return sum(cell_width(c) for c in s)


def clip(s, n):
    # The longest start of s at most n columns wide.
    out, used = [], 0
    for c in s:
        if used + cell_width(c) > n:
            break
        out.append(c)
        used += cell_width(c)
    return "".join(out)


def shorten(s, n):
    return s if width(s) <= n else clip(s, n - 1) + "…"


def pad(s, n):
    return s + " " * (n - width(s))


def centre(s, n):
    # Markers sit in the middle of their column, so a lone one lines up under a pair.
    left = (n - width(s)) // 2
    return " " * left + pad(s, n - left)


def paint(pieces, color, limit=None):
    # Join (text, style) pieces; a line wider than `limit` is cut and ends in "…".
    if limit is not None and sum(width(p) for p, _ in pieces) > limit:
        cut, room = [], limit - 1
        for piece, style in pieces:
            piece = clip(piece, room)
            room -= width(piece)
            cut.append((piece, style))
        pieces = cut + [("…", None)]
    return "".join("\x1b[%sm%s\x1b[0m" % (style, piece) if color and style else piece
                   for piece, style in pieces if piece)


def when(at, t):
    if at is None:
        return "−"
    d = t - at
    if d < 60:
        return "たった今"
    if d < 3600:
        return "%d分前" % (d // 60)
    if d < DAY:
        return "%d時間前" % (d // 3600)
    days = (datetime.fromtimestamp(t).date() - datetime.fromtimestamp(at).date()).days
    return "昨日" if days <= 1 else "%d日前" % days


def cells(r, t):
    return shorten(r["ident"], ISSUE_WIDTH), r["marker"], when(r["last"], t)


def table(rows, t, band=None):
    # Each repository's name, then its rows, with a gap between repositories.
    # Given a width, the name is a coloured band that wide; without one it is plain text.
    # Each line is (pieces, tab id or None); columns line up across repositories.
    widths = [max((width(cells(r, t)[i]) for r in rows), default=0) for i in range(3)]
    lines = []
    for name, group in sections(rows):
        if lines:
            lines.append(([], None))
        lines.append(([(pad(" %s " % name, band), HEADING_STYLE)] if band else [(name, "1")], None))
        for r in group:
            # Rows sit indented under their heading.
            pieces = [("  ", None)]
            for i, (value, w) in enumerate(zip(cells(r, t), widths)):
                # A column with nothing in any row (no markers at all) takes no room.
                if w:
                    pieces += [(centre(value, w) if i == 1 else pad(value, w), "1"), ("  ", None)]
            lines.append((pieces + [(r["summary"], "1")], r["tab"]))
    return lines


def once():
    t = now()
    try:
        rows, stale = build(t, self_tab())
    except HerdrError as e:
        print("herdr-issues: %s" % e, file=sys.stderr)
        return 0
    color = sys.stdout.isatty()
    if color:
        limit = os.get_terminal_size().columns - 1
    else:
        try:
            limit = int(os.environ.get("COLUMNS") or 160)
        except ValueError:
            limit = 160
        limit = limit if limit > 0 else 160
    out = [paint(pieces, color, limit).rstrip()
           for pieces, _ in table(rows, t, limit if color else None)]
    if stale:
        out += ([""] if out else []) + [paint([("放置 %d 件" % stale, "90")], color, limit)]
    if out:
        print("\n".join(out))
    return 0


def write(s):
    sys.stdout.write(s)
    sys.stdout.flush()


def draw(me, size, chosen):
    # Paint one frame from the top left. `chosen` is the cursor's (tab id, index):
    # it stays on its tab, or on its index when that tab is gone. Returns
    # {screen row: tab id}, the tabs of the rows drawn in order, and the cursor.
    t = now()
    note = "  %s 更新  ↑↓ で選ぶ・Enter で移動・クリックでも移動・q で終了" \
        % time.strftime("%H:%M:%S", time.localtime(t))
    screen = [([("issue 一覧", "1;4"), (note, "90")], None), ([], None)]
    try:
        rows, stale = build(t, me)
    except HerdrError as e:
        screen.append(([("herdr の状態を読めません: %s" % e, "31")], None))
        stale = 0
    else:
        # One column spare, as for every line below.
        lines = table(rows, t, size.columns - 1) or [([("Claude のタブがありません", "90")], None)]
        room = size.lines - len(screen) - (1 if stale else 0)
        if len(lines) > room:
            # What does not fit folds into one line, so no row moves under the pointer.
            keep = lines[:max(room - 1, 0)]
            hidden = sum(1 for _, tab in lines[len(keep):] if tab)
            lines = keep + [([("…ほか %d 件" % hidden, "90")], None)]
        screen += lines
    if stale:
        # The count sits on the bottom row.
        screen = screen[:size.lines - 1]
        screen += [([], None)] * (size.lines - 1 - len(screen))
        screen.append(([("放置 %d 件" % stale, "90")], None))
    screen = screen[:size.lines]
    order = [tab for _, tab in screen if tab]
    tab, index = chosen
    if order:
        index = order.index(tab) if tab in order else min(index, len(order) - 1)
        tab = order[index]
    else:
        tab = None
    # One column spare: a full last column makes some terminals wrap.
    span = size.columns - 1
    screen = [([(pad("".join(p for p, _ in pieces), span), CURSOR_STYLE)]
               if row_tab and row_tab == tab else pieces, row_tab) for pieces, row_tab in screen]
    write("\x1b[H" + "\r\n".join(paint(pieces, True, span) + "\x1b[K"
                                 for pieces, _ in screen) + "\x1b[J")
    hits = {row: row_tab for row, (_, row_tab) in enumerate(screen, 1) if row_tab}
    return hits, order, (tab, index)


def read_input(buf):
    # (quit?, events, bytes kept for the next read). Events: ("click", screen row)
    # for a left press, ("move", -1 or 1) for up or down, ("enter",).
    tail = PARTIAL.search(buf)
    done, rest = (buf[:tail.start()], buf[tail.start():]) if tail else (buf, b"")
    stop, events = False, []
    for m in INPUT.finditer(done):
        key = m.group(6)
        if m.group(1) is not None:
            if m.group(1) == b"0" and m.group(4) == b"M":
                events.append(("click", int(m.group(3))))
        elif m.group(5) is not None or key in (b"j", b"k"):
            events.append(("move", -1 if m.group(5) == b"A" or key == b"k" else 1))
        elif key in (b"\r", b"\n"):
            events.append(("enter",))
        elif key in (b"q", b"\x03"):
            stop = True
    return stop, events, rest


def focus(tab):
    try:
        subprocess.run([HERDR, "tab", "focus", tab], stdin=subprocess.DEVNULL,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    except (OSError, subprocess.SubprocessError):
        pass


BOARD = "📋 issue 一覧"
SOCKET = os.environ.get("HERDR_ISSUES_SOCKET") or os.path.join(HOME, ".config", "herdr", "herdr.sock")


def move_first(wid):
    # workspace.move has no CLI command; best effort through the API socket.
    import socket
    try:
        with socket.socket(socket.AF_UNIX) as s:
            s.settimeout(3)
            s.connect(SOCKET)
            s.sendall((json.dumps({"id": "herdr-issues", "method": "workspace.move",
                                   "params": {"workspace_id": wid, "insert_index": 0}}) + "\n").encode())
            s.recv(65536)
    except OSError:
        pass


def running(pane):
    # The board runs as argv[0] "herdr-issues" (exec -a in the bash entry).
    try:
        info = herdr("pane", "process-info", "--pane", pane)["process_info"]
        return any(isinstance(p, dict) and (p.get("argv") or [""])[0] == "herdr-issues"
                   for p in info.get("foreground_processes") or [])
    except (HerdrError, KeyError, TypeError, AttributeError):
        return False


def jump(script):
    import shlex
    try:
        boards = [text(w.get("workspace_id")) for w in entries("workspaces", "workspace", "list")
                  if text(w.get("label")) == BOARD]
        for extra in boards[1:]:
            herdr_call("workspace", "close", extra)
        if boards:
            wid = boards[0]
            panes = entries("panes", "pane", "list", "--workspace", wid)
            pane = text(panes[0].get("pane_id")) if panes else ""
            if pane and not running(pane):
                herdr_call("pane", "run", pane, shlex.quote(script))
        else:
            made = herdr("workspace", "create", "--label", BOARD, "--no-focus")
            wid = text(made["workspace"]["workspace_id"])
            herdr_call("pane", "run", text(made["root_pane"]["pane_id"]), shlex.quote(script))
    except (HerdrError, KeyError, TypeError) as e:
        print("herdr-issues: %s" % e, file=sys.stderr)
        return 1
    move_first(wid)
    herdr_call("workspace", "focus", wid)
    return 0


def herdr_call(*args):
    try:
        subprocess.run([HERDR, *args], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=10)
    except (OSError, subprocess.SubprocessError):
        pass


def live():
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        print("herdr-issues: needs a terminal; use --once", file=sys.stderr)
        return 2
    me = self_tab()
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    # Closing the tab or a kill still runs the restore below.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    signal.signal(signal.SIGHUP, lambda *_: sys.exit(0))
    try:
        tty.setraw(fd)
        write("\x1b[?1049h\x1b[?25l\x1b[?1000h\x1b[?1006h")
        # The cursor starts on the first row and outlives redraws.
        hits, order, chosen, pending, due, size = {}, [], (None, 0), b"", 0.0, None
        while True:
            if time.time() >= due or os.get_terminal_size() != size:
                size = os.get_terminal_size()
                hits, order, chosen = draw(me, size, chosen)
                due = time.time() + REFRESH
            ready, _, _ = select.select([fd], [], [], 0.5)
            if not ready:
                continue
            data = os.read(fd, 1024)
            if not data:
                return 0
            stop, events, pending = read_input(pending + data)
            for event in events:
                if event[0] == "move" and order:
                    index = max(0, min(chosen[1] + event[1], len(order) - 1))
                    chosen = (order[index], index)
                elif event[0] == "enter" and chosen[0]:
                    focus(chosen[0])
                elif event[0] == "click" and event[1] in hits:
                    tab = hits[event[1]]
                    focus(tab)
                    chosen = (tab, order.index(tab))
                # Show the change now, not at the next tick.
                due = 0
            if stop:
                return 0
    except KeyboardInterrupt:
        return 0
    finally:
        try:
            termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        except termios.error:
            pass
        try:
            write("\x1b[?1006l\x1b[?1000l\x1b[?25h\x1b[?1049l")
        except OSError:
            pass


sys.exit(once() if sys.argv[1] == "once" else jump(sys.argv[2]) if sys.argv[1] == "jump" else live())
PY

# Through -c, not stdin: the live board reads keys and clicks from stdin.
# argv[0] "herdr-issues" lets --jump tell a running board from a bare shell.
# --jump hands this path to a pane with another cwd, so make it absolute.
self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
exec -a herdr-issues python3 -I -c "$program" "$mode" "$self"
