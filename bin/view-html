#!/bin/bash
# Open a local HTML file in the browser, reusing its tab on repeat calls.
#
# `open file://...` hands the URL to the browser, which opens ANOTHER tab even
# when that exact file is already showing -- so re-rendering a page a few times
# leaves a row of stale duplicates and no way to tell which is current. This
# finds the existing tab, reloads it in place, and brings it forward.
#
# Falls back to `open` whenever the scripted path is unavailable: browser not
# running, automation permission denied, or a browser this doesn't script.
#
# Usage: view-html <file.html>
#        view-html --print-url <file.html>   # emit the URL, open nothing

set -euo pipefail

usage() {
    echo "usage: view-html [--print-url] <file.html>" >&2
    exit 64
}

print_only=false
if [[ ${1:-} == --print-url ]]; then
    print_only=true
    shift
fi
[[ $# -eq 1 ]] || usage

file=$1
[[ -f $file ]] || { echo "view-html: no such file: $file" >&2; exit 1; }

# Absolute path without requiring realpath (not present on a stock macOS).
dir=$(cd "$(dirname "$file")" && pwd)
abs="$dir/$(basename "$file")"

# Percent-encode the characters that actually break a file:// URL. Kept to a
# small set on purpose: encoding everything would mangle the path separators.
encode() {
    local s=$1
    s=${s//%/%25}
    s=${s// /%20}
    s=${s//\#/%23}
    s=${s//\?/%3F}
    printf 'file://%s' "$s"
}
url=$(encode "$abs")

if $print_only; then
    printf '%s\n' "$url"
    exit 0
fi

# The bundle id registered for https tells us which browser to script.
default_browser() {
    local plist=$HOME/Library/Preferences/LaunchServices/com.apple.launchservices.secure.plist
    [[ -f $plist ]] || plist=$HOME/Library/Preferences/com.apple.LaunchServices/com.apple.launchservices.secure.plist
    [[ -f $plist ]] || return 0
    python3 - "$plist" <<'PY' 2>/dev/null || true
import plistlib, sys
try:
    handlers = plistlib.load(open(sys.argv[1], "rb")).get("LSHandlers", [])
except Exception:
    sys.exit(0)
for h in handlers:
    if h.get("LSHandlerURLScheme") == "https":
        print(h.get("LSHandlerRoleAll", ""))
        break
PY
}

app_for() {
    case $1 in
        com.google.chrome)        echo "Google Chrome" ;;
        com.google.chrome.canary) echo "Google Chrome Canary" ;;
        com.brave.browser)        echo "Brave Browser" ;;
        com.microsoft.edgemac)    echo "Microsoft Edge" ;;
        com.apple.safari)        echo "Safari" ;;
        *)                        echo "" ;;
    esac
}

# Chromium and Safari expose different tab APIs, so the script differs. Both
# return "reloaded" or "opened" on stdout; anything else means fall back.
chromium_script() {
    local app=$1 target=$2
    osascript <<EOF 2>/dev/null
tell application "$app"
    repeat with w in windows
        set i to 0
        repeat with t in tabs of w
            set i to i + 1
            if URL of t is "$target" then
                tell t to reload
                set active tab index of w to i
                set index of w to 1
                activate
                return "reloaded"
            end if
        end repeat
    end repeat
    open location "$target"
    activate
    return "opened"
end tell
EOF
}

safari_script() {
    local target=$1
    osascript <<EOF 2>/dev/null
tell application "Safari"
    repeat with w in windows
        repeat with t in tabs of w
            if URL of t is "$target" then
                -- Safari has no reload command for a tab; re-assigning the URL
                -- is the documented way to refresh it.
                set URL of t to "$target"
                set current tab of w to t
                set index of w to 1
                activate
                return "reloaded"
            end if
        end repeat
    end repeat
    tell window 1 to set current tab to (make new tab with properties {URL:"$target"})
    activate
    return "opened"
end tell
EOF
}

bundle=$(default_browser | tr '[:upper:]' '[:lower:]')
app=$(app_for "$bundle")
result=""

# Only script a browser that is already running. Driving a launch through
# AppleScript races the app's own startup and reports failures that aren't real.
if [[ -n $app ]] && pgrep -x "$app" >/dev/null 2>&1; then
    case $bundle in
        com.apple.safari) result=$(safari_script "$url" || true) ;;
        *)                result=$(chromium_script "$app" "$url" || true) ;;
    esac
fi

case $result in
    reloaded) echo "reloaded: $url" ;;
    opened)   echo "opened: $url" ;;
    *)
        # No scripted path: automation refused, browser closed, or unknown browser.
        open "$url"
        echo "opened (via open): $url"
        ;;
esac
