#!/bin/bash
# Toggle Handy recording. Bound to Caps Lock via Karabiner.
#
# - Handy が起動中: handy --toggle-post-process
# - Handy が停止中: open -a Handy (Caps Lock を押した = 音声入力したい = Handy を
#   立ち上げて使える状態にする、という意図的なショートカット)
#
# Karabiner runs this in a minimal launchd env, so use absolute paths.

# %/* keeps the filename when there is no slash (cd bin && bash x); see lib/voice.sh.
_here="${BASH_SOURCE[0]%/*}"
[ "$_here" = "${BASH_SOURCE[0]}" ] && _here=.
. "$_here/lib/voice.sh" || exit 1

if ! handy_running; then
  /usr/bin/open -a Handy
  exit 0
fi

exec "$HANDY_BIN" --toggle-post-process
