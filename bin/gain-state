#!/bin/bash
# Track which watch sources were already visited this week.
#
# Tech news does not change by the hour, and the previous design re-read every
# source on every run. Weekly is the granularity the sources actually move at,
# so a source seen this week is skipped until the week turns.
#
# The state also carries how often each source produced something, which is
# what the skill's improvement proposals are argued from.
#
#   gain-state due <sources.yaml>              -> "<scope>\t<key>" per due source
#   gain-state record <scope> <key> <findings> -> stamp today, bump the counters
#   gain-state prune <sources.yaml>            -> drop rows the yaml no longer lists
#   gain-state list <sources.yaml>             -> every source with runs/findings/note joined in
#   gain-state snapshot <scope> <key>          -> stdin is the page now; prints the diff since last time
#
# Writers serialise on a $STATE.lock directory, so the per-source record calls
# the skill fans out do not overwrite each other.
#
# GAIN_STATE overrides the state file, GAIN_SNAPSHOTS the snapshot directory,
# and GAIN_NOW pins today, so the week boundary can be tested without waiting
# for one.

set -uo pipefail

STATE="${GAIN_STATE:-$HOME/.local/state/gain/sources.tsv}"
SNAPS="${GAIN_SNAPSHOTS:-$HOME/.local/state/gain/snapshots}"
NOW="${GAIN_NOW:-$(date '+%Y-%m-%d')}"

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

usage() { printf 'usage: gain-state due <sources.yaml> | record <scope> <key> <findings> | prune <sources.yaml> | list <sources.yaml> | snapshot <scope> <key> < content\n' >&2; exit 64; }

# ISO week, not sqlite's `weekday` modifier: that one advances to the *next*
# given weekday and stays put when today already is it, which lands a week
# early every Monday (bin/voice-quota-watch documents the same trap).
same_week() {  # $1 = YYYY-MM-DD, $2 = YYYY-MM-DD -> exit 0 when in the same ISO week
  python3 - "$1" "$2" << 'PY'
import sys
from datetime import date
def wk(s):
    try:
        return date.fromisoformat(s).isocalendar()[:2]
    except ValueError:
        return None
a, b = wk(sys.argv[1]), wk(sys.argv[2])
sys.exit(0 if a is not None and a == b else 1)
PY
}

# One "<scope>\t<key>" per source, in file order. `due` and `prune` ask the yaml
# the same question -- which sources exist -- so the parser stays in one place.
# Two copies would drift, and a drifted prune deletes rows that are still live.
list_sources() {  # $1 = sources.yaml, $2 = "notes" to append the note as a third column
  local src="$1" mode="${2:-}"
  [ -f "$src" ] || { printf 'gain-state: no sources file at %s\n' "$src" >&2; return 1; }
  # Homebrew's python3 (first on PATH above, for launchd hygiene) is externally
  # managed, so setup/install.zsh refuses to pip-install pyyaml into it and puts
  # it in mise's interpreter instead. Ask mise directly, same fallback order as
  # install.zsh's own python resolution.
  local py3
  py3="$(mise which python3 2>/dev/null || command -v python3)"
  [ -n "$py3" ] || { printf 'gain-state: no python3 found\n' >&2; return 1; }
  "$py3" - "$src" "$mode" << 'PY'
import sys, yaml
with_note = len(sys.argv) > 2 and sys.argv[2] == 'notes'
d = yaml.safe_load(open(sys.argv[1], encoding='utf-8')) or {}
KEY = {'github': 'repo', 'services': 'name', 'engineers': 'name', 'news': 'query'}
def emit(scope, key, note):
    if with_note:
        # The output is TSV; a tab or newline inside the note would shift columns.
        print(f"{scope}\t{key}\t{' '.join(str(note or '').split())}")
    else:
        print(f'{scope}\t{key}')
for scope, items in d.items():
    if scope == 'peers':
        for h in (items or {}).get('handles', []) or []:
            # A handle may be written bare or with its note. Keep reading the
            # bare form: a hand edit leaves one behind, and dropping it would
            # silently stop watching that peer.
            if isinstance(h, dict):
                if h.get('handle'):
                    emit('peers', h['handle'], h.get('note'))
            elif h:
                emit('peers', h, '')
        continue
    for it in items or []:
        k = KEY.get(scope)
        if k and isinstance(it, dict) and it.get(k):
            emit(scope, it[k], it.get('note'))
PY
}

cmd_due() {
  local src="$1" rows
  # Read the sources before the pipe, and check the status here. On the left of
  # a pipe the failure would ride on `set -o pipefail` alone, and one dropped
  # shell option turns "could not read the sources" into "no sources are due" --
  # the same empty output, and the caller skips the week instead of retrying.
  rows="$(list_sources "$src")" || return 1
  printf '%s\n' "$rows" |
  while IFS=$'\t' read -r scope key; do
    [ -n "$scope" ] && [ -n "$key" ] || continue
    last=$(awk -F'\t' -v s="$scope" -v k="$key" '$1 == s && $2 == k { print $3; exit }' "$STATE" 2>/dev/null)
    if [ -n "$last" ] && same_week "$last" "$NOW"; then
      continue
    fi
    printf '%s\t%s\n' "$scope" "$key"
  done
}

cmd_record() {
  local scope="$1" key="$2" found="$3"
  case "$found" in
    ''|*[!0-9]*) printf 'gain-state: findings must be a non-negative integer, got %s\n' "$found" >&2; exit 64 ;;
  esac
  # The directory is ensured by with_lock, which every writer goes through.
  # Failing to create the file must stop here: continuing would let mv land
  # the rewrite somewhere nothing reads back.
  [ -f "$STATE" ] || : > "$STATE" || return 1
  # Rewrite through a temp file: an in-place edit that dies half way would
  # leave the counters for every other source truncated.
  awk -F'\t' -v OFS='\t' -v s="$scope" -v k="$key" -v now="$NOW" -v f="$found" '
    $1 == s && $2 == k { print s, k, now, $4 + 1, $5 + f; hit = 1; next }
    NF >= 5           { print }
    END { if (!hit) print s, k, now, 1, f }
  ' "$STATE" > "$STATE.tmp" && mv "$STATE.tmp" "$STATE"
}

# One line per source with its track record joined in:
#   scope, key, last_checked, runs, findings, note
# "Should this source go?" is decided from runs and findings, and those live
# only in the state file. A source never visited shows runs 0 and "-" for the
# date, so it reads apart from "visited, found nothing".
cmd_list() {
  local src="$1" rows
  rows="$(list_sources "$src" notes)" || return 1
  printf '%s\n' "$rows" |
  awk -F'\t' -v OFS='\t' -v state="$STATE" '
    BEGIN {
      while ((getline line < state) > 0) {
        n = split(line, f, "\t")
        if (n >= 5) { k = f[1] FS f[2]; last[k] = f[3]; runs[k] = f[4]; found[k] = f[5] }
      }
    }
    NF >= 2 {
      k = $1 FS $2
      print $1, $2, (k in last ? last[k] : "-"), (k in runs ? runs[k] : 0),
            (k in found ? found[k] : 0), (NF >= 3 ? $3 : "")
    }
  '
}

# A source dropped from the yaml keeps its row here forever: never updated,
# still carrying runs/findings. The improvement proposals argue "no track
# record" from those counters, so a stale row argues about a source that is
# already gone. Drop what the yaml no longer lists.
cmd_prune() {
  local src="$1" keep
  keep="$(list_sources "$src")" || return 1
  # An empty list would orphan every row at once. That is far likelier to be the
  # wrong file than a real "watch nothing", so refuse rather than wipe history.
  [ -n "$keep" ] || { printf 'gain-state: %s lists no sources; refusing to prune\n' "$src" >&2; return 1; }
  [ -f "$STATE" ] || return 0
  # Same temp-file rewrite as record, for the same reason: a half-written
  # in-place edit truncates the counters of every source that survived.
  : > "$STATE.tmp" || return 1
  # Removed keys go to stdout so the caller can report what it dropped.
  awk -F'\t' -v OFS='\t' -v tmp="$STATE.tmp" '
    NR == FNR        { live[$0] = 1; next }
    NF < 5           { next }
    ($1 FS $2) in live { print > (tmp); next }
                     { print $1, $2 }
  ' <(printf '%s\n' "$keep") "$STATE" && mv "$STATE.tmp" "$STATE"
}

# record and prune each rewrite the whole file, so two at once lose each other's
# work: both read the old state and the later mv wins, while the loser still
# exits 0. That is the normal path, not a rare race -- the skill calls record
# once per source and the harness runs independent calls in parallel. macOS
# ships no flock(1), so mkdir is the portable atomic primitive: it either
# creates the directory or fails, with no window in between.
# `due` reads only, and every write lands by mv (atomic), so readers never see
# a half-written file and take no lock.
# The state file must be a regular file, and every subcommand has to say so
# before touching it -- readers included, which take no lock. `[ -f ]` alone
# folds "missing" and "something else is there" into the same false, and both
# readers then fail quietly: awk on a directory errors into /dev/null and
# reports every source as never visited, and awk on a FIFO blocks for a writer
# that never comes. Both look like an answer. "Missing" stays fine: that is
# what a first run looks like.
check_state() {
  if [ -e "$STATE" ] && [ ! -f "$STATE" ]; then
    printf 'gain-state: %s is not a regular file\n' "$STATE" >&2
    return 1
  fi
}

with_lock() {
  local dir="$STATE.lock" waited=0 rc
  # `${STATE%/*}` hands back the whole string when it holds no slash, so an
  # unqualified GAIN_STATE would mkdir a *directory* named after the state
  # file. mv then drops the rewrite inside it and still reports success: the
  # write is gone, every source stays due forever, and nothing says so.
  case "$STATE" in */*) mkdir -p "${STATE%/*}" 2>/dev/null ;; esac
  until mkdir "$dir" 2>/dev/null; do
    waited=$((waited + 1))
    # 30s. A writer holds the lock for milliseconds, so this only trips when a
    # previous run died hard and left the directory behind -- say so plainly
    # rather than block forever or delete a lock that may still be live.
    [ "$waited" -le 300 ] || {
      printf 'gain-state: timed out waiting for %s (remove it if no gain-state is running)\n' "$dir" >&2
      return 75
    }
    sleep 0.1
  done
  # Drop the temp file BEFORE releasing the lock, never after. Released first,
  # the next writer takes the lock and creates its own $STATE.tmp, and this
  # cleanup deletes it out from under that writer's mv -- losing its row.
  trap 'rm -f "$STATE.tmp"; rm -rf "$dir"' EXIT INT TERM
  "$@"
  rc=$?
  # A failed awk leaves behind the empty temp file it created; clear it here.
  rm -f "$STATE.tmp"
  rm -rf "$dir"
  trap - EXIT INT TERM
  return "$rc"
}

# Sources whose page carries no dated entries -- a reference doc rather than a
# changelog -- have nothing to extract by date. Scoring them "collected, found
# nothing" reads a shape mismatch as a poor track record, and that is exactly
# what decides which sources get dropped. Compare against the last copy instead.
#
# The first run prints nothing: emitting the whole page as a diff would fill a
# digest with one entry. Silence means "nothing changed", which is the answer
# the digest wants either way.
cmd_snapshot() {
  local scope="$1" key="$2" py3
  py3="$(mise which python3 2>/dev/null || command -v python3)"
  [ -n "$py3" ] || { printf 'gain-state: no python3 found\n' >&2; return 1; }
  # Pass the program with -c, not on stdin. `python3 -` reads the program from
  # stdin, which is where the page content has to arrive -- the program would
  # eat it and every run would look unchanged.
  "$py3" -c '
import difflib, re, sys
from pathlib import Path
root, scope, key = Path(sys.argv[1]), sys.argv[2], sys.argv[3]
# The key is a repo path, a URL or a Japanese query, so it cannot be a file
# name as written. Fold everything else to _: with no separator left, no
# spelling of the key can climb out of the snapshot directory.
name = re.sub(r"[^A-Za-z0-9._-]", "_", key)[:120]
if name.strip(".") == "":
    name = "_"
safe_scope = re.sub(r"[^A-Za-z0-9._-]", "_", scope)[:40] or "_"
path = root / safe_scope / name
path.parent.mkdir(parents=True, exist_ok=True)
now = sys.stdin.read()
was = path.read_text(encoding="utf-8") if path.is_file() else None
path.write_text(now, encoding="utf-8")
if was is None or was == now:
    raise SystemExit(0)
sys.stdout.writelines(difflib.unified_diff(
    was.splitlines(keepends=True), now.splitlines(keepends=True),
    fromfile=f"{scope}/{key} (前回)", tofile=f"{scope}/{key} (今回)", n=2))
' "$SNAPS" "$scope" "$key"
}

case "${1:-}" in
  due)    [ $# -eq 2 ] || usage; check_state || exit 1; cmd_due "$2" ;;
  record) [ $# -eq 4 ] || usage; check_state || exit 1; with_lock cmd_record "$2" "$3" "$4" ;;
  prune)  [ $# -eq 2 ] || usage; check_state || exit 1; with_lock cmd_prune "$2" ;;
  list)   [ $# -eq 2 ] || usage; check_state || exit 1; cmd_list "$2" ;;
  snapshot) [ $# -eq 3 ] || usage; cmd_snapshot "$2" "$3" ;;
  *)      usage ;;
esac
