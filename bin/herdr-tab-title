#!/bin/bash
# Rename the current herdr tab to a short task name.
#
#   herdr-tab-title <name...>
#
# Outside herdr this is a no-op. Names are cut to 20 characters (not bytes);
# the current label's leading marker (herdr-mark) and trailing state mark are kept.

set -euo pipefail

name="$*"
name="${name#"${name%%[![:space:]]*}"}"
name="${name%"${name##*[![:space:]]}"}"
if [ -z "$name" ]; then
  echo "usage: herdr-tab-title <name>" >&2
  exit 2
fi

herdr="${HERDR_BIN:-herdr}"
[ -n "${HERDR_TAB_ID:-}" ] || exit 0
command -v "$herdr" >/dev/null 2>&1 || exit 0

# The current label's trailing state mark (📤 🪵 🔥 ✅, set by github-sync / next-task)
# survives the rename, so the tab keeps showing the issue's state. So does a
# leading marker from the user's set, which herdr-issues shows as the state.
current="$("$herdr" tab list 2>/dev/null || true)"
marks="${HERDR_MARKS_FILE:-$HOME/.local/state/herdr/marks.tsv}"
name="$(python3 - "$name" "$HERDR_TAB_ID" "$current" "$marks" <<'PY'
import json, re, sys
name, tab_id, raw, marks = sys.argv[1][:20], sys.argv[2], sys.argv[3], sys.argv[4]
mark_re = re.compile(r"\s*(📤|🪵|🔥|✅)\ufe0f?$")
try:
    tabs = json.loads(raw)["result"]["tabs"]
    label = next(t.get("label") or "" for t in tabs if t.get("tab_id") == tab_id)
except (ValueError, KeyError, TypeError, StopIteration):
    label = ""
m = mark_re.search(label)
if m and not mark_re.search(name):
    name = f"{name} {m.group(1)}"
try:
    with open(marks, encoding="utf-8") as f:
        markers = [line.split("\t")[0].strip() for line in f]
except OSError:
    markers = []
# The longest first, so a marker is not mistaken for a shorter one it starts with.
lead = next((k for k in sorted(markers, key=len, reverse=True) if k and label.startswith(k)), "")
if lead and not name.startswith(lead):
    name = lead + name
print(name)
PY
)"

"$herdr" tab rename "$HERDR_TAB_ID" "$name" >/dev/null 2>&1 \
  || echo "herdr-tab-title: rename failed" >&2
exit 0
