#!/bin/bash
# Render a markdown file to HTML beside it and print one URL that opens it.
#
#   md-view <path.md>
#
# The URL is http://127.0.0.1:8765/... when bin/md-view-server answers for the
# page, and a click then opens the browser; the terminal only reveals a
# file:// link in Finder. For the server the page is copied to
# ~/.cache/md-view/<folder>/<name>.html, and copies older than 30 days are
# removed on each run. Without the server the URL is the file:// one.
#
# Overrides: MD_VIEW_DIR (the served directory, absolute), MD_VIEW_PORT,
# PANDOC_BIN.
# Exit: 0 ok, 1 missing file or pandoc, 2 usage or a bad override.

set -euo pipefail

PANDOC="${PANDOC_BIN:-pandoc}"
serve_dir="${MD_VIEW_DIR:-$HOME/.cache/md-view}"
port="${MD_VIEW_PORT:-8765}"

usage() { echo "使い方: md-view <path.md>" >&2; exit 2; }
bad_port() { echo "md-view: MD_VIEW_PORT は 1〜65535 の整数にしてください: $port" >&2; exit 2; }

[ $# -eq 1 ] || usage
src="$1"
case "$src" in
  *.md) ;;
  *) usage ;;
esac
# md-view-server reads the same two and refuses what is refused here.
case "$serve_dir" in
  /*) ;;
  *) echo "md-view: MD_VIEW_DIR は絶対パスにしてください: $serve_dir" >&2; exit 2 ;;
esac
# Digits only, no leading zero: the text goes into the URL as it is.
case "$port" in
  0* | *[!0-9]* | ??????*) bad_port ;;
esac
[ "$port" -le 65535 ] || bad_port
[ -f "$src" ] || { echo "md-view: ファイルがありません: $src" >&2; exit 1; }
command -v "$PANDOC" >/dev/null 2>&1 || { echo "md-view: pandoc が見つかりません" >&2; exit 1; }

out="${src%.md}.html"

# The page title is the first H1; the file name stands in when there is none.
title="$(sed -n 's/^# \{1,\}//p' "$src" | head -n1)"
[ -n "$title" ] || title="$(basename "$src" .md)"

# A full template instead of pandoc's default page: its built-in CSS caps the
# text at 36em. The look follows Zenn's article page.
tpl="$(mktemp)"
trap 'rm -f "$tpl"' EXIT
cat > "$tpl" <<'HTML'
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>$pagetitle$</title>
<style>
:root {
  --bg: #edf2f7; --panel: #fff; --text: rgba(0, 0, 0, .82); --muted: #65717b;
  --line: #d6e3ed; --link: #0f83fd; --code-bg: rgba(33, 90, 160, .07);
  --pre-bg: #1a2638; --accent: #0b62b8; --code-text: #b3246b; --marker: #fff1a8; --th-bg: #edf2f7; --td-line: #cfdce6;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 1.5rem; }
body {
  margin: 0; background: var(--bg); color: var(--text);
  font-family: -apple-system, "system-ui", "Hiragino Kaku Gothic ProN", "Hiragino Sans", Meiryo, sans-serif;
  font-size: 16px; line-height: 1.9; -webkit-font-smoothing: antialiased;
  word-break: break-word; overflow-wrap: break-word;
}
.layout {
  display: flex; align-items: flex-start; gap: 2rem;
  max-width: 1200px; margin: 0 auto; padding: 2.5rem 1.5rem 5rem;
}
main {
  flex: 1 1 auto; min-width: 0; background: var(--panel);
  border-radius: 12px; padding: 40px 40px 56px;
}
nav.toc {
  flex: 0 0 300px; position: sticky; top: 1.5rem;
  max-height: calc(100vh - 3rem); overflow-y: auto;
  background: var(--panel); border-radius: 12px; padding: 20px;
  font-size: .86rem; line-height: 1.5;
}
nav.toc::before {
  content: "目次"; display: block; margin-bottom: .8rem;
  color: var(--text); font-size: 1rem; font-weight: 700;
}
nav.toc ul { list-style: none; margin: 0; padding: 0; }
nav.toc > ul > li > a { display: none; }
nav.toc > ul > li > ul { position: relative; padding-left: 21px; }
nav.toc > ul > li > ul::before {
  content: ""; position: absolute; top: 12px; bottom: 12px; left: 5px;
  width: 2px; background: var(--line);
}
nav.toc li { position: relative; }
nav.toc a {
  display: block; padding: 4px 0; color: var(--muted); text-decoration: none; font-weight: 600;
}
nav.toc > ul > li > ul > li > a::before {
  content: ""; position: absolute; top: 9px; left: -21px; width: 12px; height: 12px;
  border-radius: 50%; background: var(--line); border: 2px solid var(--panel);
}
nav.toc ul ul ul { padding-left: 0; }
nav.toc ul ul ul a { font-size: .8rem; font-weight: 400; }
nav.toc ul ul ul a::before {
  content: ""; position: absolute; top: 12px; left: -18px; width: 6px; height: 6px;
  border-radius: 50%; background: var(--line);
}
nav.toc a:hover { color: var(--text); }
nav.toc a:hover::before { background: var(--link) !important; }
h1, h2, h3, h4, h5, h6 { font-weight: 700; line-height: 1.5; }
h1 { font-size: 1.7em; margin: 0 0 1.5rem; padding-bottom: .3em; border-bottom: 3px solid var(--link); }
h2 { font-size: 1.5em; margin: 2.3em 0 1.1rem; padding: 0 0 .2em .6em; border-bottom: 1px solid var(--line);
  border-left: 6px solid var(--link); color: var(--accent); }
h3 { font-size: 1.3em; margin: 2.25em 0 .5rem; color: var(--accent); }
h4 { font-size: 1.1em; margin: 2.25em 0 .5rem; }
p { margin: 1.5em 0 0; }
h1 + p, h2 + p, h3 + p, h4 + p { margin-top: .3em; }
a { color: var(--link); text-decoration: none; }
a:hover { text-decoration: underline; }
strong { font-weight: 700; background: linear-gradient(transparent 60%, var(--marker) 60%); }
ul, ol { margin: 1.4rem 0; padding-left: 1.8em; line-height: 1.7; }
li { margin: .4rem 0; }
li > ul, li > ol { margin: 0; }
li::marker { color: var(--link); font-weight: 700; }
ul.task-list { list-style: none; padding-left: .5em; }
hr { border: 0; border-top: 2px solid var(--line); margin: 2.5rem 0; }
blockquote {
  margin: 1.4rem 0; padding: 2px 0 2px .7em; font-size: .97em;
  border-left: 3px solid var(--link); color: #505c64; background: #f5f9fc;
}
blockquote p { margin: 1rem 0; }
blockquote > :first-child { margin-top: 0; }
blockquote > :last-child { margin-bottom: 0; }
table {
  display: block; width: auto; max-width: 100%; overflow-x: auto;
  border-collapse: collapse; margin: 1.2rem auto; font-size: .95em; line-height: 1.5;
}
th, td { border: 1px solid var(--td-line); padding: .5rem; text-align: left; background: var(--panel); }
th { background: var(--th-bg); color: var(--accent); font-weight: 700; }
code {
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace, "Apple Color Emoji";
  font-size: .85em; background: var(--code-bg); color: var(--code-text); padding: .2em .4em; border-radius: 4px;
  vertical-align: .08em;
}
pre {
  margin: 1.3rem 0; padding: 1.1rem; background: var(--pre-bg); color: #cfe8ff;
  border-radius: 4px; overflow-x: auto; font-size: .9em; line-height: 1.6;
}
pre code { background: none; padding: 0; font-size: inherit; color: inherit; vertical-align: 0; }
img { max-width: 100%; }
@media (max-width: 992px) {
  .layout { display: block; padding: 0 0 3rem; }
  nav.toc { display: none; }
  main { border-radius: 0; padding: 24px 16px 40px; }
}
@media print {
  body { background: #fff; }
  nav.toc { display: none; }
  main { padding: 0; }
}
</style>
</head>
<body>
<div class="layout">
<main>
$body$
</main>
$if(toc)$
<nav class="toc">
$table-of-contents$
</nav>
$endif$
</div>
</body>
</html>
HTML

"$PANDOC" --standalone --template="$tpl" --toc --toc-depth=3 \
  --metadata pagetitle="$title" -o "$out" "$src"

# Three lines: the folder of the served copy, the page's URL on the server and
# its file:// URL. The folder is the first 16 hex digits of the sha256 of the
# md's real path, so one md keeps one URL.
urls="$(python3 -c '
import hashlib, os, sys, urllib.parse
from pathlib import Path
md, page = (Path(p).resolve() for p in sys.argv[1:3])
folder = hashlib.sha256(os.fsencode(md)).hexdigest()[:16]
name = urllib.parse.quote(os.fsencode(page.name))
print(folder)
print(f"http://127.0.0.1:{sys.argv[3]}/{folder}/{name}")
print(page.as_uri())
' "$src" "$out" "$port")"
{
  read -r folder
  read -r http_url
  read -r file_url
} <<< "$urls"

# Copies older than 30 days go, then the folders that leaves empty. Only
# <16 hex>/<name>.html is touched, the shape this script creates, so a
# mistaken MD_VIEW_DIR loses nothing else.
sweep() {
  local shape
  shape="$(printf '[0-9a-f]%.0s' {1..16})"
  cd "$serve_dir" || return 0
  find . -mindepth 2 -maxdepth 2 -type f -path "./$shape/*.html" -mtime +30 -delete
  find . -mindepth 1 -maxdepth 1 -type d -name "$shape" -empty -delete
}

# True when the server hands out this very page. Nothing listening, another
# program on the port, a server over another directory: each would make the
# URL a dead link, while file:// still opens the page. Loopback answers in
# milliseconds, so a second without one means no.
served() {
  [ "$(curl -s -o /dev/null -I --noproxy '*' --max-time 1 -w '%{http_code}' "$1" 2> /dev/null)" = 200 ]
}

# From here on nothing may cost the URL: file:// opens the page whether or
# not the sweep, the copy or the server works. The sweep runs in a subshell
# for its cd.
(sweep) 2> /dev/null || true
if mkdir -p "$serve_dir/$folder" && cp "$out" "$serve_dir/$folder/" && served "$http_url"; then
  echo "$http_url"
else
  echo "$file_url"
fi
