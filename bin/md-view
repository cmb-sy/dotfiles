#!/bin/bash
# Render a markdown file to HTML beside it and print the file:// URL.
#
#   md-view <path.md>
#
# Exit: 0 ok, 1 missing file or pandoc, 2 usage.

set -euo pipefail

PANDOC="${PANDOC_BIN:-pandoc}"

usage() { echo "使い方: md-view <path.md>" >&2; exit 2; }

[ $# -eq 1 ] || usage
src="$1"
case "$src" in
  *.md) ;;
  *) usage ;;
esac
[ -f "$src" ] || { echo "md-view: ファイルがありません: $src" >&2; exit 1; }
command -v "$PANDOC" >/dev/null 2>&1 || { echo "md-view: pandoc が見つかりません" >&2; exit 1; }

out="${src%.md}.html"

# The page title is the first H1; the file name stands in when there is none.
title="$(sed -n 's/^# \{1,\}//p' "$src" | head -n1)"
[ -n "$title" ] || title="$(basename "$src" .md)"

# A full template instead of pandoc's default page: its built-in CSS caps the
# text at 36em and has no dark colors.
tpl="$(mktemp)"
trap 'rm -f "$tpl"' EXIT
cat > "$tpl" <<'HTML'
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>$pagetitle$</title>
<style>
:root {
  --bg: #f7f6f2; --panel: #ffffff; --text: #2b2f36; --muted: #6b7280;
  --line: #e2e0d9; --accent: #2f6f6a; --accent-soft: #e4efed;
  --code-bg: #f0eee8; --head-bg: #efede6; --zebra: #faf9f6;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #17191e; --panel: #1e2127; --text: #d3d6dc; --muted: #8b93a1;
    --line: #30343c; --accent: #7fc8bf; --accent-soft: #223533;
    --code-bg: #262a31; --head-bg: #262a31; --zebra: #21242a;
  }
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 1.5rem; }
body {
  margin: 0; background: var(--bg); color: var(--text);
  font-family: "Hiragino Sans", "Hiragino Kaku Gothic ProN", -apple-system, "Yu Gothic", sans-serif;
  font-size: 16px; line-height: 1.85; -webkit-font-smoothing: antialiased;
}
.layout { display: flex; gap: 2.5rem; max-width: 1180px; margin: 0 auto; padding: 2.5rem 1.5rem 5rem; }
nav.toc {
  flex: 0 0 240px; position: sticky; top: 1.5rem; align-self: flex-start;
  max-height: calc(100vh - 3rem); overflow-y: auto; font-size: .82rem; line-height: 1.5;
}
nav.toc::before {
  content: "目次"; display: block; margin-bottom: .6rem;
  color: var(--muted); font-size: .72rem; font-weight: 600; letter-spacing: .12em;
}
nav.toc ul { list-style: none; margin: 0; padding: 0; }
nav.toc ul ul { margin-left: .8rem; border-left: 1px solid var(--line); }
nav.toc > ul > li > a { display: none; }
nav.toc > ul > li > ul { margin-left: 0; border-left: 0; }
nav.toc a {
  display: block; padding: .28rem .6rem; border-radius: 6px;
  color: var(--muted); text-decoration: none;
}
nav.toc a:hover { background: var(--accent-soft); color: var(--accent); }
main {
  flex: 1 1 auto; min-width: 0; max-width: 820px; background: var(--panel);
  border: 1px solid var(--line); border-radius: 14px; padding: 2.5rem 3rem 3.5rem;
}
h1, h2, h3, h4 { line-height: 1.4; font-weight: 700; }
h1 { font-size: 1.75rem; margin: 0 0 2rem; padding-bottom: 1.1rem; border-bottom: 3px solid var(--accent); }
h2 { font-size: 1.3rem; margin: 3.2rem 0 1rem; padding: .1rem 0 .1rem .8rem; border-left: 5px solid var(--accent); }
h3 { font-size: 1.08rem; margin: 2.2rem 0 .7rem; }
h4 { font-size: 1rem; margin: 1.6rem 0 .5rem; color: var(--muted); }
p { margin: .9rem 0; }
a { color: var(--accent); text-underline-offset: 3px; }
strong { font-weight: 700; background: linear-gradient(transparent 62%, var(--accent-soft) 62%); }
ul, ol { padding-left: 1.5rem; margin: .8rem 0; }
li { margin: .3rem 0; }
li::marker { color: var(--accent); }
hr { border: 0; border-top: 1px solid var(--line); margin: 2.5rem 0; }
blockquote {
  margin: 1.2rem 0; padding: .7rem 1.1rem; background: var(--accent-soft);
  border-left: 4px solid var(--accent); border-radius: 0 8px 8px 0;
}
blockquote p { margin: .3rem 0; }
table {
  display: block; width: max-content; max-width: 100%; overflow-x: auto;
  border-collapse: collapse; margin: 1.3rem 0; font-size: .92rem; line-height: 1.65;
}
th, td { border: 1px solid var(--line); padding: .55rem .85rem; text-align: left; vertical-align: top; }
th { background: var(--head-bg); font-weight: 700; white-space: nowrap; }
tbody tr:nth-child(even) td { background: var(--zebra); }
code {
  font-family: "SF Mono", Menlo, Consolas, monospace; font-size: .86em;
  background: var(--code-bg); padding: .12em .4em; border-radius: 5px;
}
pre {
  background: var(--code-bg); border: 1px solid var(--line); border-radius: 10px;
  padding: 1rem 1.2rem; overflow-x: auto; line-height: 1.55; font-size: .88rem;
}
pre code { background: none; padding: 0; font-size: inherit; }
img { max-width: 100%; }
ul.task-list { list-style: none; padding-left: .3rem; }
@media (max-width: 900px) {
  .layout { display: block; padding: 1rem .75rem 3rem; }
  nav.toc { display: none; }
  main { padding: 1.5rem 1.2rem 2.5rem; border-radius: 10px; }
}
@media print {
  body { background: #fff; }
  nav.toc { display: none; }
  main { border: 0; padding: 0; max-width: none; }
}
</style>
</head>
<body>
<div class="layout">
$if(toc)$
<nav class="toc">
$table-of-contents$
</nav>
$endif$
<main>
$body$
</main>
</div>
</body>
</html>
HTML

"$PANDOC" --standalone --template="$tpl" --toc --toc-depth=3 \
  --metadata pagetitle="$title" -o "$out" "$src"

python3 -c 'import sys,pathlib;print(pathlib.Path(sys.argv[1]).resolve().as_uri())' "$out"
