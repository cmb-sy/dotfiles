# Claude Code: committed binary / npm artifacts kept out of git
claude/slackcli
claude/package.json
claude/package-lock.json

# Local-only learning notes. Docs that code points at are excepted below, so a
# fresh clone does not have dangling references; everything else stays local.
# `docs/*` not `docs/`: git cannot re-include a file whose parent directory is
# excluded, so each level is excluded by glob and re-included by name.
docs/*
!docs/debug/
docs/debug/*
!docs/debug/2026-06-23-caps-lock-rogue-dictation.md
!docs/superpowers/
docs/superpowers/*
!docs/superpowers/specs/
docs/superpowers/specs/*
!docs/superpowers/specs/2026-06-22-claude-tts-design.md
!docs/superpowers/specs/2026-07-11-oci-claude-server-design.md

# pptx-dev: python venv + per-session artifacts
claude/skills/pptx-dev/scripts/.venv/
claude/skills/pptx-dev/scripts/uv.lock
.pptx-dev/
# 証券アプリの端末識別情報 (PII)。追跡しない (2026-07-11 untrack 済み)
.config/Futu-Mac/

# Playwright MCP browser artifacts
.playwright-mcp/

# Editor scratch files (vim/nvim swap + undo), created whenever a file is
# opened from lazygit or an editor session is interrupted
*.swp
*.swo
*.un~

# R session history, dropped into whatever directory R was started in
.Rhistory

# python bytecode cache, written when a test imports test/helpers/wcag.py
__pycache__/

# The global gitignore drops lib/ as build output; bin/lib is tracked source.
# Un-ignore the directory itself: git cannot re-include a file whose parent
# directory is excluded.
!bin/lib/
